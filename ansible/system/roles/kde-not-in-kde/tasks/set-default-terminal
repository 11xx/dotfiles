---
- name: Set default terminal application in kdeglobals
  community.general.kdeconfig:
    path: "{{ ansible_facts['user_dir'] }}/.config/kdeglobals"
    values:
      - group: General
        key: TerminalApplication
        value: "{{ kde_terminal_application }}"
      - group: General
        key: TerminalService
        value: "{{ kde_terminal_service }}"
  become: false
