---
- name: Check if kwriteconfig6 is available on PATH
  ansible.builtin.command:
    cmd: which kwriteconfig6
  register: kwriteconfig6_check
  changed_when: false
  failed_when: false
  become: false

- name: Fail with a clear message if kwriteconfig6 is missing
  ansible.builtin.fail:
    msg: >
      kwriteconfig6 was not found on PATH for user '{{ ansible_facts['user_id'] }}'.
      This role requires it (usually provided by 'kde-cli-tools' on Arch Linux).
      Ensure another role installs it before this one runs.
  when: kwriteconfig6_check.rc != 0

- ansible.builtin.import_tasks: set-default-terminal
