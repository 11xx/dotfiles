[Unit]
# Managed by Ansible (role: pak_services) — edit the role, not this file.
Description=Pi-hole + Unbound + Caddy + Vaultwarden stack
After=network-online.target
Wants=network-online.target
Requires=podman.socket

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ pak_services_dir }}
Environment=PODMAN_SYSTEMD_UNIT=%n
# `down` first so a unit restart after a config change actually recreates the
# containers instead of finding them already up and doing nothing.
ExecStart=podman-compose down
ExecStart=podman-compose pull
ExecStart=podman-compose up -d
ExecStop=podman-compose down
# Caddy is built from source with xcaddy on a Pi 4. It is not quick.
TimeoutStartSec=900

[Install]
WantedBy=default.target
