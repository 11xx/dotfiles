# Managed by Ansible (role: shell) — edit the role, not this file.
#
# zsh reads this on every invocation, interactive or not, before anything else.
# It exists only to move the rest of the config out of $HOME.

# Emacs TRAMP and any other dumb terminal get a shell with no line editor and a
# plain prompt. A themed prompt makes TRAMP hang waiting for a banner it cannot
# parse, and this is the earliest point at which that can be prevented.
if [[ $TERM == dumb ]] || [[ -n $INSIDE_EMACS ]]; then
    unsetopt zle
    PS1='$ '
    export HISTFILE=$HOME/.tramp_history
    return
fi

export XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
export XDG_DATA_HOME=${XDG_DATA_HOME:-$HOME/.local/share}
export XDG_CACHE_HOME=${XDG_CACHE_HOME:-$HOME/.cache}
export XDG_STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state}

export ZDOTDIR={{ zdotdir }}
