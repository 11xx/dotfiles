#jinja2: trim_blocks: True, lstrip_blocks: True
# Managed by Ansible (role: shell) — edit the role, not this file.
#
# Plugins are installed as plain checkouts. The order matters: syntax
# highlighting wraps the line editor and must see its widgets already defined.
# History-substring-search rebinds keys highlighting has just hooked, so it
# follows.
#
# A missing plugin is skipped so the shell remains usable.
ZSH_PLUGIN_DIR={{ zsh_plugin_dir }}

{% for plugin in zsh_plugins %}
[[ -r $ZSH_PLUGIN_DIR/{{ plugin.name }}/{{ plugin.entry }} ]] &&
    source $ZSH_PLUGIN_DIR/{{ plugin.name }}/{{ plugin.entry }}
{% endfor %}

# Written by `p10k configure` and loaded after the theme.
[[ -r ${ZDOTDIR:-$HOME}/.p10k.zsh ]] && source "${ZDOTDIR:-$HOME}/.p10k.zsh"

AUTOSUGGESTION_ACCEPT_RIGHT_ARROW=1
