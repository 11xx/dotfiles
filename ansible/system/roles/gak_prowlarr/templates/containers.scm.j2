(oci-container-configuration
 (provision "prowlarr")
 (image "{{ gak_prowlarr_image }}")
 (requirement '(file-system-/media))
 (network "starrs_net")
 (ports (list '("{{ gak_prowlarr_port }}" . "9696")))
 (volumes
  (list '("{{ gak_media_dir }}/.config/prowlarr/config" . "/config")))
 (environment
  (list '("PUID" . "{{ gak_media_uid }}")
        '("PGID" . "{{ gak_media_gid }}")
        '("UMASK" . "002")
        '("TZ" . "{{ gak_timezone }}")))
 (extra-arguments
  (list "--uidmap" "0:1:1"
        "--gidmap" "0:1:1"
        "--gidmap" "{{ gak_media_gid }}:{{ gak_media_gid }}:1")))
