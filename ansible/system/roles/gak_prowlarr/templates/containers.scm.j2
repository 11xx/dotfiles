(oci-container-configuration
 (provision "prowlarr")
 (image "{{ gak_prowlarr_image }}")
 (network "starrs_net")
 (ports (list '("{{ gak_prowlarr_port }}" . "9696")))
 (volumes
  (list '("{{ gak_prowlarr_dir }}/config" . "/config")))
 (environment
  (list '("PUID" . "{{ gak_media_uid }}")
        '("PGID" . "{{ gak_media_gid }}")
        '("UMASK" . "002")
        '("TZ" . "{{ gak_timezone }}")))
 (extra-arguments
  (list "--uidmap" "0:1:1"
        "--uidmap" "1:0:1"
        "--uidmap" "2:2:{{ gak_subid_count - 1 }}"
        "--gidmap" "0:1:1"
        "--gidmap" "1:0:1"
        "--gidmap" "2:2:{{ gak_subid_count - 1 }}"))
 (respawn? #t))
