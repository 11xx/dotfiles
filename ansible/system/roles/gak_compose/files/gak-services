#!/bin/sh
# Launch the Compose updater on the interpreter its Guix profile declares.
#
# `/bin/sh` is the one interpreter this host guarantees at an absolute path, so
# this script starts from an empty environment. It then selects the declared
# profile explicitly rather than searching PATH: the profile's generated
# environment supplies the module search path, and the profile's own python3
# runs the implementation. An interpreter elsewhere on PATH is never consulted,
# and `-I` keeps an inherited PYTHONPATH, PYTHONHOME or user site directory out
# of the result.
set -eu

program=${0##*/}

fail() {
    printf '%s: %s\n' "$program" "$*" >&2
    exit 1
}

: "${HOME:?HOME is required}"

profile=${GAK_SERVICES_HOME_PROFILE:-"$HOME/.guix-home/profile"}
implementation=${GAK_SERVICES_IMPLEMENTATION:-"${0%/*}/gak-services.py"}

[ -d "$profile" ] ||
    fail "the declared profile is missing: $profile (apply it with 'guix home reconfigure')"
[ -r "$profile/etc/profile" ] ||
    fail "the declared profile has no generated environment: $profile/etc/profile"
[ -x "$profile/bin/python3" ] ||
    fail "the declared profile has no interpreter: $profile/bin/python3"
[ -r "$implementation" ] ||
    fail "the updater implementation is missing: $implementation"

# The generated snippet prepends to these, so they must exist to be prepended
# to, and must not carry a value from outside the profile.
unset PYTHONPATH PYTHONHOME PYTHONSTARTUP
GUIX_PYTHONPATH=
PATH=${PATH:-}
GUIX_PROFILE=$profile
export GUIX_PYTHONPATH PATH GUIX_PROFILE

. "$profile/etc/profile"

exec "$profile/bin/python3" -I "$implementation" "$@"
