(oci-container-configuration
 (provision "qbittorrent")
 (image "{{ gak_qbittorrent_image }}")
 (requirement '(file-system-/media))
 (network "starrs_net")
 (ports (list '("{{ gak_qbittorrent_port }}" . "{{ gak_qbittorrent_port }}")
              '("{{ gak_qbittorrent_peer_port }}" . "6881")
              "{{ gak_qbittorrent_peer_port }}:6881/udp"))
 (volumes
  (list '("{{ gak_media_dir }}/.config/qbittorrent/config" . "/config")
        '("{{ gak_media_dir }}/Media" . "/Media")))
 (environment
  (list '("PUID" . "{{ gak_media_uid }}")
        '("PGID" . "{{ gak_media_gid }}")
        '("UMASK" . "002")
        '("TZ" . "{{ gak_timezone }}")
        '("WEBUI_PORT" . "{{ gak_qbittorrent_port }}")
        '("TORRENTING_PORT" . "6881")))
 (extra-arguments
  (list "--uidmap" "0:1:1"
        "--uidmap" "1:0:1"
        "--uidmap" "2:2:{{ gak_subid_count - 1 }}"
        "--gidmap" "0:1:1"
        "--gidmap" "1:0:1"
        "--gidmap" "2:2:{{ gak_subid_count - 1 }}"))
 (respawn? #t))
