FROM quay.io/fedora/fedora:44

# Agent runtimes intentionally float so rebuilds pick up current upstream CLIs.
ARG OPENCODE_VERSION="latest"
ARG CODEX_VERSION="latest"
ARG T3_CODE_VERSION="latest"
ARG PI_CODE_VERSION="latest"

# Standalone binary tools are pinned for reproducible builds and to avoid
# GitHub API release lookups during image construction.
ARG HADOLINT_VERSION="2.14.0"
ARG WATCHEXEC_VERSION="2.5.1"
ARG TYPOS_VERSION="1.46.0"
ARG TAPLO_VERSION="0.10.0"
ARG ACTIONLINT_VERSION="1.7.12"
ARG DUCKDB_VERSION="1.5.2"

RUN --mount=type=cache,target=/var/cache/libdnf5 \
    --mount=type=cache,target=/var/cache/dnf \
    dnf -y --setopt=keepcache=True upgrade --refresh

# Eclipse Temurin JDKs.
# Fedora 44 retired java-21-openjdk, while Gradle/Android builds should not
# run against Fedora's floating java-latest package.
RUN printf '%s\n' \
    '[Adoptium]' \
    'name=Adoptium' \
    'baseurl=https://packages.adoptium.net/artifactory/rpm/fedora/$releasever/$basearch' \
    'enabled=1' \
    'gpgcheck=1' \
    'gpgkey=https://packages.adoptium.net/artifactory/api/gpg/key/public' \
    > /etc/yum.repos.d/adoptium.repo

# Fedora-packaged tools.
RUN --mount=type=cache,target=/var/cache/libdnf5 \
    --mount=type=cache,target=/var/cache/dnf \
    dnf -y --setopt=install_weak_deps=False --setopt=keepcache=True install \
    # === Essentials for OpenCode / Codex / T3 ===
    # Required for Node runtimes, native addon builds, VCS, shells, process tools,
    # archive handling, agent search, and upstream binary installs.
    ca-certificates \
    curl \
    findutils \
    gcc-c++ \
    git \
    gzip \
    jq \
    make \
    nodejs \
    npm \
    openssh-clients \
    procps-ng \
    python3 \
    ripgrep \
    shadow-utils \
    tar \
    unzip \
    wget \
    which \
    xz \
    # === Agent-managed deferred toolchains ===
    # Present for agents to use only when needed; no cargo installs happen at build time.
    cargo \
    openssl-devel \
    pkgconf-pkg-config \
    rust \
    # === Arbitrary Additional Tools ===
    # Optional editors, linters, and CLI utilities (safe to modify or remove).
    podman \
    fd-find \
    bat \
    bubblewrap \
    eza \
    emacs \
    entr \
    git-delta \
    less \
    nano \
    shellcheck \
    sqlite \
    strace \
    tree \
    tmux \
    uv \
    vim-enhanced \
    yq \
    ctags \
    # === Haskell ===
    # ghcup deps; intentionally repeated with essentials so this block can be
    # added or removed without changing the harness/runtime dependency block.
    gcc \
    gcc-c++ \
    gmp \
    gmp-devel \
    make \
    ncurses \
    ncurses-compat-libs \
    xz \
    perl \
    zlib-devel \
    # === Fedora-packaged extras ===
    shfmt \
    just \
    gh \
    tokei \
    hyperfine \
    du-dust \
    git-filter-repo \
    gitleaks \
    miller \
    lua lua-devel \
    # === Java / Kotlin / Android ===
    # Gradle wrappers and Android Gradle Plugin provide Gradle/Kotlin bits per project;
    # the image supplies a stable JDK 21 and CLI utilities needed to bootstrap
    # the Android SDK.
    temurin-21-jdk \
    zip

# Upstream binary tools not available in Fedora repos.
RUN set -eux; \
    curl_retry() { \
        curl -fL \
            --retry 5 \
            --retry-all-errors \
            --retry-delay 2 \
            --connect-timeout 20 \
            --max-time 300 \
            "$@"; \
    }; \
    tmp="$(mktemp -d)"; \
    trap 'rm -rf "$tmp"' EXIT; \
    arch="$(uname -m)"; \
    case "$arch" in \
        x86_64|amd64) \
            watchexec_target="x86_64-unknown-linux-gnu"; \
            typos_target="x86_64-unknown-linux-musl"; \
            taplo_arch="x86_64"; \
            actionlint_arch="amd64"; \
            duckdb_dist="linux-amd64"; \
            hadolint_arch="x86_64"; \
            ;; \
        aarch64|arm64) \
            watchexec_target="aarch64-unknown-linux-gnu"; \
            typos_target="aarch64-unknown-linux-musl"; \
            taplo_arch="aarch64"; \
            actionlint_arch="arm64"; \
            duckdb_dist="linux-arm64"; \
            hadolint_arch="arm64"; \
            ;; \
        *) \
            echo "Unsupported architecture: $arch" >&2; \
            exit 1; \
            ;; \
    esac; \
    \
    hadolint_version="${HADOLINT_VERSION#v}"; \
    watchexec_version="${WATCHEXEC_VERSION#v}"; \
    typos_version="${TYPOS_VERSION#v}"; \
    taplo_version="${TAPLO_VERSION#v}"; \
    actionlint_version="${ACTIONLINT_VERSION#v}"; \
    duckdb_version="${DUCKDB_VERSION#v}"; \
    \
    echo "Installing hadolint ${hadolint_version}..." >&2; \
    curl_retry -o /usr/local/bin/hadolint \
        "https://github.com/hadolint/hadolint/releases/download/v${hadolint_version}/hadolint-Linux-${hadolint_arch}"; \
    chmod 0755 /usr/local/bin/hadolint; \
    \
    echo "Installing watchexec ${watchexec_version}..." >&2; \
    curl_retry -o "$tmp/watchexec.tar.xz" \
        "https://github.com/watchexec/watchexec/releases/download/v${watchexec_version}/watchexec-${watchexec_version}-${watchexec_target}.tar.xz"; \
    tar -xJf "$tmp/watchexec.tar.xz" -C "$tmp"; \
    install -m 0755 "$tmp/watchexec-${watchexec_version}-${watchexec_target}/watchexec" /usr/local/bin/watchexec; \
    \
    echo "Installing typos ${typos_version}..." >&2; \
    mkdir -p "$tmp/typos"; \
    curl_retry -o "$tmp/typos.tar.gz" \
        "https://github.com/crate-ci/typos/releases/download/v${typos_version}/typos-v${typos_version}-${typos_target}.tar.gz"; \
    tar -xzf "$tmp/typos.tar.gz" -C "$tmp/typos"; \
    install -m 0755 "$tmp/typos/typos" /usr/local/bin/typos; \
    \
    echo "Installing taplo ${taplo_version}..." >&2; \
    curl_retry "https://github.com/tamasfe/taplo/releases/download/${taplo_version}/taplo-linux-${taplo_arch}.gz" \
        | gzip -d > /usr/local/bin/taplo; \
    chmod 0755 /usr/local/bin/taplo; \
    \
    echo "Installing actionlint ${actionlint_version}..." >&2; \
    mkdir -p "$tmp/actionlint"; \
    curl_retry -o "$tmp/actionlint.tar.gz" \
        "https://github.com/rhysd/actionlint/releases/download/v${actionlint_version}/actionlint_${actionlint_version}_linux_${actionlint_arch}.tar.gz"; \
    tar -xzf "$tmp/actionlint.tar.gz" -C "$tmp/actionlint"; \
    install -m 0755 "$tmp/actionlint/actionlint" /usr/local/bin/actionlint; \
    \
    echo "Installing duckdb ${duckdb_version}..." >&2; \
    curl_retry "https://install.duckdb.org/v${duckdb_version}/duckdb_cli-${duckdb_dist}.gz" \
        | gzip -d > /usr/local/bin/duckdb; \
    chmod 0755 /usr/local/bin/duckdb; \
    \
    hadolint --version; \
    watchexec --version; \
    typos --version; \
    taplo --version; \
    actionlint -version; \
    test "$(duckdb -noheader -init /dev/null -csv -batch -s 'SELECT 2*3*7')" = "42"

# Global Node-based tools.
RUN npm install -g @ast-grep/cli \
 && npm cache clean --force

RUN groupadd -g 1000 node \
 && useradd -m -u 1000 -g 1000 -s /bin/bash node \
 && mkdir -pv /work \
 && ln -sfn /work /workspace \
 && chown node:node /work

USER node
WORKDIR /work

ENV HOME=/home/node
ENV NPM_CONFIG_PREFIX=/home/node/.npm-global
ENV XDG_BIN_HOME=/home/node/.bin
ENV UV_TOOL_BIN_DIR=$XDG_BIN_HOME
ENV CARGO_HOME=/home/node/.cargo
ENV CABAL_DIR=/home/node/.cabal
ENV JAVA_HOME=/usr/lib/jvm/temurin-21-jdk
ENV ANDROID_HOME=/home/node/Android/Sdk
ENV ANDROID_SDK_ROOT=$ANDROID_HOME
ENV GRADLE_USER_HOME=/home/node/.gradle
ENV PATH=$JAVA_HOME/bin:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$CARGO_HOME/bin:$XDG_BIN_HOME:/home/node/.npm-global/bin:$PATH

RUN mkdir -pv \
    /home/node/.npm-global \
    /home/node/.bin \
    /home/node/.cargo/bin \
    /home/node/.gradle \
    /home/node/Android/Sdk \
    /home/node/.agents/skills \
    /home/node/.config/opencode \
    /home/node/.local/share/opencode \
    /home/node/.local/state/opencode \
    /home/node/.codex \
    /home/node/.t3/userdata \
    /home/node/.pi/agent \
    /work

RUN java -version \
 && javac -version \
 && test -x "$JAVA_HOME/bin/java"

# User-scope installs.
RUN uv tool install pyright \
 && uv cache clean

RUN npm install -g \
    "opencode-ai@${OPENCODE_VERSION}" \
    "@openai/codex@${CODEX_VERSION}" \
    "t3@${T3_CODE_VERSION}" \
    "@earendil-works/pi-coding-agent@${PI_CODE_VERSION}" \
 && npm cache clean --force

COPY --chown=node:node bin/ /home/node/.bin/
RUN find /home/node/.bin -type f -exec chmod +x {} +

COPY --chown=node:node init.sh /home/node/init.sh
RUN chmod +x /home/node/init.sh

ENTRYPOINT ["/home/node/init.sh"]

CMD ["sleep", "infinity"]
