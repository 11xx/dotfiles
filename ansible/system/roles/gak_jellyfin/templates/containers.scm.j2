(oci-container-configuration
 (provision "jellyfin")
 (image "{{ gak_jellyfin_image }}")
 (requirement '(file-system-/media))
 (network "starrs_net")
 (ports (list '("{{ gak_jellyfin_port }}" . "8096")))
 (volumes
  (list '("{{ gak_jellyfin_dir }}/config" . "/config")
        '("{{ gak_jellyfin_dir }}/cache" . "/cache")
        '("{{ gak_media_dir }}/Media" . "/Media")))
 (extra-arguments
  (list "--uidmap" "0:1:1"
        "--uidmap" "1:0:1"
        "--uidmap" "2:2:{{ gak_subid_count - 1 }}"
        "--gidmap" "0:1:1"
        "--gidmap" "1:0:1"
        "--gidmap" "2:2:{{ gak_subid_count - 1 }}"))
 (respawn? #t))
