#!/usr/bin/env python3
import re
import subprocess
import sys
from pathlib import Path


HOME = Path("/home/aiagent")
PODMAN = "/run/current-system/profile/bin/podman"
PROJECT = HOME / "services/agent/compose.yaml"
NAME = "aiagent"
FORMAT = "{{.Id}}|{{.State.Running}}|{{.State.Status}}|{{.State.ExitCode}}"


class StopError(Exception):
    pass


def inspect(reference):
    result = subprocess.run(
        [PODMAN, "inspect", "--type=container", "--format", FORMAT, reference],
        capture_output=True, text=True, timeout=30,
    )
    if result.returncode:
        raise StopError("the recorded agent container could not be inspected")
    fields = result.stdout.strip().split("|")
    if len(fields) != 4 or not re.fullmatch(r"[0-9a-f]{64}", fields[0]):
        raise StopError("the agent container inspection was malformed")
    identity, running, status, exit_code = fields
    if (running not in ("true", "false") or status not in
            ("running", "exited", "created", "stopped", "paused")
            or not exit_code.isdecimal() or int(exit_code) > 255):
        raise StopError("the agent container state was malformed")
    return identity, running == "true", status, int(exit_code)


def current():
    result = subprocess.run(
        [PODMAN, "container", "exists", NAME],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30,
    )
    if result.returncode == 1:
        return None
    if result.returncode:
        raise StopError("agent container existence could not be verified")
    return inspect(NAME)


def stop():
    before = current()
    if before is not None and before[2] not in ("running", "exited", "created", "stopped"):
        raise StopError("agent container is not in a stoppable state")
    if before is not None and before[1] != (before[2] == "running"):
        raise StopError("agent container running state was inconsistent")
    result = subprocess.run([PODMAN, "compose", "-f", str(PROJECT), "stop"],
                            timeout=180)
    if before is None:
        if current() is not None:
            raise StopError("an agent container appeared during the stop")
        if result.returncode:
            raise StopError(f"Compose stop exited {result.returncode}")
        print("aiagent: no container was running; project remains stopped", flush=True)
        return 0
    after = inspect(before[0])
    named = current()
    if after[0] != before[0] or named is None or named != after:
        raise StopError("the agent container identity changed during the stop")
    if after[1] or after[2] not in ("exited", "stopped", "created"):
        raise StopError("the recorded agent container is still active")
    if before[1]:
        if before[2] != "running" or after[2] != "exited":
            raise StopError("the running agent did not reach an exited state")
        if after[3] == 124:
            print(f"aiagent: warning: T3 shutdown escalated for container {after[0][:12]}; "
                  "agent remains stopped (exit 124)", file=sys.stderr, flush=True)
            if result.returncode:
                raise StopError(f"Compose stop also exited {result.returncode} after escalation")
            return 124
        if result.returncode:
            raise StopError(f"Compose stop exited {result.returncode}")
        if after[3]:
            raise StopError(f"agent container {after[0][:12]} exited {after[3]}; "
                            "agent remains stopped")
        print(f"aiagent: container {after[0][:12]} stopped gracefully", flush=True)
    else:
        if result.returncode:
            raise StopError(f"Compose stop exited {result.returncode}")
        if after[3] == 124:
            print(f"aiagent: warning: container {after[0][:12]} was already stopped "
                  "with historical exit 124", file=sys.stderr, flush=True)
        else:
            print(f"aiagent: container {after[0][:12]} was already stopped "
                  f"(historical exit {after[3]})", flush=True)
    return 0


if __name__ == "__main__":
    try:
        if sys.argv[1:]:
            raise StopError("usage: aiagent-stop-outcome")
        sys.exit(stop())
    except (OSError, StopError, subprocess.TimeoutExpired) as error:
        print(f"aiagent: stop failed: {error}; no later action is safe",
              file=sys.stderr)
        sys.exit(1)
