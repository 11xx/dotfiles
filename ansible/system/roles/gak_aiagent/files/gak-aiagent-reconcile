#!/usr/bin/env python3
"""Reconcile agent containers whose recorded processes died without conmon exit state."""

import json
import os
from pathlib import Path
import subprocess
import sys


PODMAN = os.environ.get("GAK_AIAGENT_PODMAN", "/run/current-system/profile/bin/podman")


def podman(*args, check=True):
    result = subprocess.run([PODMAN, *args], capture_output=True, text=True)
    if check and result.returncode:
        raise RuntimeError(f"podman {args[0]} failed: {result.stderr.strip()}")
    return result


def inspect(container):
    return json.loads(podman("inspect", "--type", "container", container).stdout)[0]["State"]


def process_alive(pid, *, conmon=False):
    if not isinstance(pid, int) or pid <= 0:
        return False
    process = Path("/proc") / str(pid)
    try:
        stat = (process / "stat").read_text()
        state = stat[stat.rfind(")") + 2]
        if state in ("Z", "X"):
            return False
        if conmon:
            return (process / "comm").read_text().strip() == "conmon"
        return True
    except FileNotFoundError:
        return False


def reconcile():
    containers = json.loads(podman("ps", "-a", "--format", "json").stdout) or []
    for container in containers:
        if str(container.get("State", "")).lower() != "running":
            continue
        container_id = container["Id"]
        state = inspect(container_id)
        if not state["Running"]:
            continue
        if process_alive(state.get("Pid")) and process_alive(
            state.get("ConmonPid"), conmon=True
        ):
            continue
        current = inspect(container_id)
        if not current["Running"] or (current.get("Pid"), current.get("ConmonPid")) != (
            state.get("Pid"), state.get("ConmonPid")
        ):
            continue
        if process_alive(current.get("Pid")) and process_alive(
            current.get("ConmonPid"), conmon=True
        ):
            continue
        podman("stop", "--time", "0", container_id, check=False)
        if inspect(container_id)["Running"]:
            raise RuntimeError(f"stale container remains running: {container_id[:12]}")
        print(f"reconciled stale container {container_id[:12]}", flush=True)


if __name__ == "__main__":
    try:
        reconcile()
    except (IndexError, KeyError, OSError, ValueError, RuntimeError) as error:
        print(f"gak-aiagent-reconcile: {error}", file=sys.stderr)
        raise SystemExit(1)
