#!/usr/bin/env python3
import fcntl
import json
import os
from pathlib import Path
import shutil
import stat
import sys
import time


HOME = Path("/home/node")
SEED = Path("/opt/aiagent-provider-seed")
PREFIX = HOME / ".local/aiagent/npm"
MARKER = ".aiagent-seed.json"
PACKAGES = {
    "claude": "@anthropic-ai/claude-code",
    "codex": "@openai/codex",
    "opencode": "opencode-ai",
    "pi": "@earendil-works/pi-coding-agent",
    "ncu": "npm-check-updates",
    "npm-check-updates": "npm-check-updates",
}


class PrefixError(Exception):
    pass


def plain_directory(path):
    try:
        return stat.S_ISDIR(path.lstat().st_mode)
    except FileNotFoundError:
        return False


def present(path):
    return path.exists() or path.is_symlink()


def package_path(root, name):
    return root / "lib/node_modules" / name


def check_package(root, command, name, required, owned):
    package = package_path(root, name)
    link = root / "bin" / command
    installed = present(package)
    linked = present(link)
    if not installed and not linked and not required:
        return
    if (not plain_directory(package.parent) or not plain_directory(package)
            or not link.is_symlink()):
        raise PrefixError(f"incomplete {name} installation in {root}")
    if owned and (package.stat().st_uid != os.getuid() or
                  not os.access(package, os.W_OK) or
                  package.parent.stat().st_uid != os.getuid() or
                  not os.access(package.parent, os.W_OK)):
        raise PrefixError(f"{name} installation is not writable by the container user")
    manifest = package / "package.json"
    if not manifest.is_file() or manifest.is_symlink():
        raise PrefixError(f"invalid {name} package manifest in {root}")
    try:
        details = json.loads(manifest.read_text())
        bins = details["bin"]
        if not isinstance(bins, dict) or command not in bins:
            raise TypeError
        package_root = package.resolve(strict=True)
        for binary, declared in bins.items():
            if not isinstance(binary, str) or not binary or "/" in binary or binary in (".", ".."):
                raise TypeError
            binary_link = root / "bin" / binary
            target = (package / declared).resolve(strict=True)
            linked_target = binary_link.resolve(strict=True)
            if (not binary_link.is_symlink() or target != linked_target
                    or not target.is_relative_to(package_root) or not target.is_file()
                    or not os.access(target, os.X_OK)):
                raise TypeError
    except (OSError, ValueError, KeyError, TypeError, RuntimeError):
        raise PrefixError(f"invalid {name} package entry point in {root}") from None
    if details.get("name") != name or not isinstance(details.get("version"), str):
        raise PrefixError(f"invalid {name} package entry point in {root}")


def check_tree(root, required, owned=False):
    for directory in (root, root / "bin", root / "lib", root / "lib/node_modules"):
        if not plain_directory(directory):
            raise PrefixError(f"missing or linked npm directory: {directory}")
        if owned and (directory.stat().st_uid != os.getuid() or
                      not os.access(directory, os.W_OK)):
            raise PrefixError(f"npm directory is not writable by the container user: {directory}")
    for command, name in PACKAGES.items():
        check_package(root, command, name, required, owned)


def check_marker(root):
    marker = root / MARKER
    if not marker.is_file() or marker.is_symlink():
        raise PrefixError("provider prefix has no valid completion marker; use explicit reseed")
    if marker.stat().st_uid != os.getuid():
        raise PrefixError("provider prefix completion marker is not owned by the container user")
    try:
        value = json.loads(marker.read_text())
    except (OSError, ValueError):
        raise PrefixError("provider prefix completion marker is unreadable; use explicit reseed") from None
    if value != {"schema": 1, "prefix": str(PREFIX)}:
        raise PrefixError("provider prefix completion marker is invalid; use explicit reseed")


def check_selected():
    parent_directory(create=False)
    if not plain_directory(PREFIX):
        raise PrefixError("provider prefix is missing or linked; use explicit reseed")
    check_marker(PREFIX)
    check_tree(PREFIX, required=False, owned=True)


def parent_directory(create=True):
    if not plain_directory(HOME) or HOME.stat().st_uid != os.getuid():
        raise PrefixError("persistent container home is missing or not owned by the container user")
    for directory in (HOME / ".local", PREFIX.parent):
        if create and not present(directory):
            directory.mkdir(mode=0o700)
        if (not plain_directory(directory) or directory.stat().st_uid != os.getuid()
                or not os.access(directory, os.W_OK)):
            raise PrefixError(f"untrusted provider prefix parent: {directory}")


def staged_seed():
    check_tree(SEED, required=True)
    parent_directory()
    stage = PREFIX.parent / f".npm-seed-{os.getpid()}-{time.monotonic_ns()}"
    try:
        shutil.copytree(SEED, stage, symlinks=True)
        marker = stage / MARKER
        marker.write_text(json.dumps({"schema": 1, "prefix": str(PREFIX)}) + "\n")
        marker.chmod(0o600)
        check_tree(stage, required=True)
        return stage
    except BaseException:
        if plain_directory(stage):
            shutil.rmtree(stage)
        raise


def ensure():
    parent_directory()
    if present(PREFIX):
        check_selected()
        return
    if list(PREFIX.parent.glob("npm.before-reseed-*")):
        raise PrefixError("provider reseed was interrupted; inspect the retained prefix backup")
    if list(PREFIX.parent.glob(".npm-seed-*")):
        raise PrefixError("provider seed is incomplete; use explicit reseed")
    stage = staged_seed()
    try:
        if present(PREFIX):
            raise PrefixError("provider prefix appeared during initialization")
        stage.rename(PREFIX)
    finally:
        if plain_directory(stage):
            shutil.rmtree(stage)
    check_selected()


def reseed():
    parent_directory()
    for incomplete in PREFIX.parent.glob(".npm-seed-*"):
        if not plain_directory(incomplete):
            raise PrefixError(f"invalid incomplete provider seed: {incomplete}")
        retained = PREFIX.parent / f"npm.incomplete-{time.time_ns()}"
        incomplete.rename(retained)
        print(f"incomplete provider seed retained at {retained}")
    stage = staged_seed()
    backup = None
    try:
        if present(PREFIX):
            backup = PREFIX.parent / f"npm.before-reseed-{time.time_ns()}"
            PREFIX.rename(backup)
        try:
            stage.rename(PREFIX)
        except OSError:
            if backup is not None and not present(PREFIX):
                backup.rename(PREFIX)
            raise
    finally:
        if plain_directory(stage):
            shutil.rmtree(stage)
    check_selected()
    if backup is not None:
        print(f"previous provider prefix retained at {backup}")


def status():
    check_tree(SEED, required=True)
    check_selected()
    print(f"selected user-owned npm prefix: {PREFIX}")
    seen = set()
    for command, name in PACKAGES.items():
        if name in seen:
            continue
        seen.add(name)
        seed = json.loads((package_path(SEED, name) / "package.json").read_text())["version"]
        selected = package_path(PREFIX, name)
        version = json.loads((selected / "package.json").read_text())["version"] if selected.exists() else "absent"
        print(f"{command}: {version} (image seed {seed})")


def main():
    command = sys.argv[1:]
    if command == ["check-seed"]:
        check_tree(SEED, required=True)
    elif command == ["check"]:
        check_selected()
    elif command == ["status"]:
        status()
    elif command in (["ensure"], ["reseed"]):
        parent_directory()
        with (PREFIX.parent / ".provider-prefix.lock").open("a+") as lock:
            os.fchmod(lock.fileno(), 0o600)
            fcntl.flock(lock, fcntl.LOCK_EX)
            if command == ["ensure"]:
                ensure()
            else:
                reseed()
    else:
        raise PrefixError("usage: aiagent-provider-prefix {check-seed|check|status|ensure|reseed}")


if __name__ == "__main__":
    try:
        main()
    except (OSError, PrefixError) as error:
        print(f"aiagent provider prefix: {error}", file=sys.stderr)
        sys.exit(1)
