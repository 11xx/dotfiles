FROM quay.io/fedora/fedora:44

ARG OPENCODE_VERSION=1.18.32
ARG CODEX_VERSION=0.156.1
ARG CLAUDE_CODE_VERSION=2.1.281
ARG T3_CODE_VERSION=0.0.42
ARG PI_CODE_VERSION=0.87.1
ARG PI_NODE_VERSION=22.23.1
ARG NCU_VERSION=22.2.9

RUN dnf -y upgrade --refresh \
 && dnf -y install --setopt=install_weak_deps=False \
      bash ca-certificates curl fd-find findutils gcc-c++ git gzip jq less make \
      nodejs npm openssh-clients procps-ng python3 ripgrep shellcheck \
      tar tmux unzip which xz \
 && dnf clean all

RUN npm install -g --prefix /opt/aiagent-provider-seed \
      "opencode-ai@${OPENCODE_VERSION}" \
      "@openai/codex@${CODEX_VERSION}" \
      "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
      "@earendil-works/pi-coding-agent@${PI_CODE_VERSION}" \
      "npm-check-updates@${NCU_VERSION}" \
 && npm install -g "t3@${T3_CODE_VERSION}" \
 && npm cache clean --force

RUN case "$(uname -m)" in \
      x86_64) pi_node_arch=x64; pi_node_sha256=9749e988f437343b7fa832c69ded82a312e41a03116d766797ac14f6f9eee578 ;; \
      aarch64) pi_node_arch=arm64; pi_node_sha256=0294e8b915ab75f92c7513d2fcb830ae06e10684e6c603e99a87dbf8835389c1 ;; \
      *) exit 1 ;; \
    esac \
 && pi_node_archive="node-v${PI_NODE_VERSION}-linux-${pi_node_arch}.tar.xz" \
 && curl -fsSLo /tmp/pi-node.tar.xz "https://nodejs.org/dist/v${PI_NODE_VERSION}/${pi_node_archive}" \
 && printf '%s  %s\n' "$pi_node_sha256" /tmp/pi-node.tar.xz | sha256sum -c - \
 && mkdir -p /opt/pi-node \
 && tar -xJf /tmp/pi-node.tar.xz -C /opt/pi-node --strip-components=2 "node-v${PI_NODE_VERSION}-linux-${pi_node_arch}/bin/node" \
 && rm /tmp/pi-node.tar.xz

RUN case "$(uname -m)" in \
      x86_64) t3_arch=x64 ;; \
      aarch64) t3_arch=arm64 ;; \
      *) exit 1 ;; \
    esac \
 && npm install -g "@t3code/t3-linux-${t3_arch}@${T3_CODE_VERSION}" \
 && npm cache clean --force \
 && ln -s "/usr/local/lib/node_modules/t3/node_modules/@t3code/t3-linux-${t3_arch}/t3" /usr/local/bin/t3-native \
 && t3-native serve --help >/dev/null

RUN groupadd -g 1001 node \
 && useradd -u 1001 -g 1001 -d /home/node -s /bin/bash node \
 && mkdir -p /home/node /work /cache \
 && chown -R node:node /home/node /work /cache

COPY --chmod=0755 init.sh /usr/local/bin/aiagent-init
COPY --chmod=0755 bin/ /usr/local/bin/
COPY --chmod=0755 init.d/ /usr/local/share/aiagent/init.d/
COPY --chmod=0644 bashrc.d/ /usr/local/share/aiagent/bashrc.d/
COPY --chmod=0644 profile.d/aiagent-path.sh /etc/profile.d/aiagent-path.sh
RUN install -d /opt/aiagent-shims/bin \
 && mv /usr/local/bin/pi /opt/aiagent-shims/bin/pi

USER node
ENV HOME=/home/node \
    XDG_CACHE_HOME=/cache/xdg \
    NPM_CONFIG_CACHE=/cache/npm \
    NPM_CONFIG_PREFIX=/home/node/.local/aiagent/npm \
    PATH=/opt/aiagent-shims/bin:/home/node/.local/aiagent/npm/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    TMPDIR=/cache/tmp
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/aiagent-init"]
CMD ["/usr/local/bin/t3-supervise"]
