name: agent

services:
  agent:
    image: localhost/aiagent-fedora:44-v1
    container_name: aiagent
    init: true
    stop_grace_period: 45s
    userns_mode: keep-id
    user: "1001:1001"
    ports:
      - "127.0.0.1:{{ gak_t3_port }}:3773"
    volumes:
      - /home/aiagent/container-home:/home/node:rw
      - /home/aiagent/workspaces:/work:rw
      - /home/aiagent/cache:/cache:rw

x-update:
  readiness:
    - /home/aiagent/.local/bin/gak-aiagent-update-ready
  readiness-timeout: 120
