;;; Managed by Ansible (role: guix_config) — edit the role, not this file.
;;;
;;; Ansible ships this file. Normal runs only deploy it; the explicit
;;; guix-activate post-task may apply it after all Ansible-owned files are
;;; present. A bad expression here can leave the host unbootable, and a
;;; reconfigure is slow enough to want a human watching it. Apply by hand, on
;;; the host when that post-task is not used:
;;;
;;;   sudo guix system reconfigure -L ~/.config/guix/modules ~/.config/guix/system.scm
;;;
;;; /etc/config.scm is the installer's original and is not used by anything.

(use-modules (gnu)
             (gnu system nss)
             (nongnu packages linux)
             (nongnu system linux-initrd)
             (gnu packages base)
             (gnu packages freedesktop)
             (gnu packages linux)
             (gnu packages shells)
             (gnu services nfs)
             (gnu system accounts)
             (guix gexp)
{% if gak_aiagent_host_enabled | bool %}
             (aiagent host)
{% endif %}
{% if gak_git_hub_enabled | bool %}
             (aiagent git-hub)
{% endif %}
