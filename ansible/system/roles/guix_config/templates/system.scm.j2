(define %plain-nonguix-signing-key-pub
  (plain-file "nonguix.pub"
              (string-append "(public-key\n"
                             "(ecc (curve Ed25519)\n"
                             "(q #C1FD53E5D4CE971933EC50C9F307AE2171A2D3B52C804642A7A35F84F3A4EA98#)))")))

{% if gak_git_hub_enabled | bool %}
