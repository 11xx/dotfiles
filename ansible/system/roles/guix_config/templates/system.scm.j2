(define %gak-operator-runtime-deadline-seconds 180)
(define %gak-operator-runtime-request-seconds 30)
(define %gak-operator-runtime-poll-seconds 1)
(define %gak-operator-runtime-command-seconds 5)

(define %gak-operator-runtime-program
  (program-file
   "gak-operator-runtime"
   #~(begin
       (define runtime "/run/user/{{ gak_media_uid }}")
       (define (uptime-seconds)
         (call-with-input-file "/proc/uptime" read))
       (define (command-exit . args)
         (status:exit-val
          (apply system* #$(file-append coreutils "/bin/timeout")
                 "--signal=KILL"
                 #$(number->string %gak-operator-runtime-command-seconds)
                 args)))
       (define (runtime-state)
         (let ((metadata
                (catch 'system-error (lambda () (lstat runtime))
                  (lambda _ #f))))
           (cond ((not metadata) 'missing)
                 ((not (eq? (stat:type metadata) 'directory)) 'type)
                 ((not (= (stat:uid metadata) {{ gak_media_uid }})) 'owner)
                 ((not (= (logand (stat:mode metadata) #o777) #o700)) 'mode)
                 (else 'ready))))
       (define (describe-state state)
         (if (eq? state 'missing)
             "missing"
             (let ((mount-status
                    (command-exit #$(file-append util-linux "/bin/findmnt")
                                  "-n" "--mountpoint" runtime)))
               (string-append
                (cond ((equal? mount-status 0) "mount")
                      ((equal? mount-status 1) "plain")
                      (else "mount status unknown"))
                " " (symbol->string state)))))
       (let* ((account (getpwnam "lobo"))
              (uid (passwd:uid account))
              (started (uptime-seconds))
              (deadline (+ started #$%gak-operator-runtime-deadline-seconds)))
         (unless (= uid {{ gak_media_uid }})
           (error "operator account UID does not match runtime path"))
         (let loop ((requested? #f))
           (let ((state (runtime-state)))
             (cond
              ((eq? state 'ready) #t)
              ((>= (uptime-seconds) deadline)
               (error (string-append
                       "operator runtime directory /run/user/1000 not ready; last observed state: "
                       (describe-state state)
                       "; expected UID 1000 and mode 0700; check loginctl show-user lobo -p Linger -p RuntimePath, then sudo herd enable gak-compose && sudo herd start gak-compose")))
              (else
               (let ((request-now?
                      (and (not requested?)
                           (>= (- (uptime-seconds) started)
                               #$%gak-operator-runtime-request-seconds))))
                 (when request-now?
                   (unless (equal? (command-exit
                                    #$(file-append elogind "/bin/loginctl")
                                    "enable-linger" "lobo") 0)
                     (display "elogind linger request failed; waiting for operator runtime\n"
                              (current-error-port))))
                 (sleep #$%gak-operator-runtime-poll-seconds)
                 (loop (or requested? request-now?)))))))))))

(operating-system
 ;; kernel & microcode
 (kernel linux)
 (initrd microcode-initrd)
 (firmware (list linux-firmware))

 (locale "en_US.utf8")
 (timezone "America/Sao_Paulo")
 (keyboard-layout (keyboard-layout "us"))
 (host-name "gak")

 (users (cons* (user-account
                (name "lobo")
                (group "lobo")
                (shell (file-append zsh "/bin/zsh"))
                (home-directory "/home/lobo")
                (supplementary-groups '("wheel" "netdev" "cgroup"
                                        "users" "media")))
               %base-user-accounts))
 (groups (append (list
                  (user-group (name "lobo") (id 1000))
                  (user-group (name "media") (id 134) (system? #t))
                  ) %base-groups))

 (packages (append (map specification->package
                        (list "git"
                              "eza"
                              "fd"
                              "bat"
                              "ripgrep"
                              "rsync"
                              "restic"))
                   %base-packages))

 ;; To search for available services, run 'guix system search KEYWORD'
 (services
  (append (list
           (service openssh-service-type)
           (service dhcpcd-service-type)
           (service ntp-service-type)
           (service avahi-service-type)

           ;; The LAN, written down.
           ;;
           ;; This machine's only nameserver is pak, and pak's resolver runs in
           ;; a container on pak. So DNS for the house depends on pak being up,
           ;; and the NFS exports below are keyed on a hostname — which made
           ;; serving files to ak depend on a Raspberry Pi that is not involved
           ;; in serving files to ak. A power cut took pak down and nfsd came up
           ;; with nothing exported, needing a hand to recover.
           ;;
           ;; Static entries break that: exportfs resolves these three names out
           ;; of /etc/hosts without a packet leaving the machine, so the NAS
           ;; keeps serving whether or not pak has finished booting, or is
           ;; booting at all. Nothing to poll and nothing to wait for.
           ;;
           ;; DNS for everything else still goes to pak, and still fails when
           ;; pak is down. That is fine — nothing here needs it.
           (simple-service 'lan-hosts hosts-service-type
                           (list (host "{{ ak_address }}" "{{ ak_fqdn }}" '("ak"))
                                 (host "{{ gak_address }}" "{{ gak_fqdn }}" '("gak"))
                                 (host "{{ pak_address }}" "{{ pak_fqdn }}" '("pak"))))

           ;; Exports are read once, when nfsd starts. After changing them:
           ;;   sudo herd restart nfs
           ;; and to see what is actually exported right now:
           ;;   guix shell nfs-utils -- sudo exportfs -v
           (service nfs-service-type
                    (nfs-configuration
                     (exports '(("/turak" "{{ ak_fqdn }}(rw,no_all_squash,root_squash)")
                                ("/media" "{{ ak_fqdn }}(rw,no_all_squash,root_squash)")
                                ("/marak" "{{ ak_fqdn }}(rw,no_all_squash,root_squash)")))))


           ;; Reaches gak's services from outside the house without forwarding a
           ;; port or exposing anything to the internet. The daemon runs with no
           ;; identity of its own until it is authenticated once, by hand, on
           ;; the host:
           ;;
           ;;   sudo tailscale up
           ;;
           ;; That prints a URL to approve the machine, and the resulting node
           ;; key is kept under /var/lib/tailscale. It survives reconfigures, so
           ;; this is a first-boot step rather than a recurring one.
           ;;
           ;; `-no-logs-no-support` is the default here: it stops the daemon
           ;; uploading logs to Tailscale, and gives up their technical support
           ;; in exchange, which is the trade this machine wants.
           (service tailscale-service-type
                    (tailscale-configuration
                     (tailscale local:tailscale)))

           (service elogind-service-type)
           ;; [[https://www.reddit.com/r/GUIX/comments/15vb7la/xdg_runtime_dir/][XDG_RUNTIME_DIR : r/GUIX]]
           (service iptables-service-type)
           ;; Enables iptables for podman
           ;; Fixes:
           ;; > Error: unable to start container "...": netavark: code: 3, msg: Backtrace:
           ;; > ...
           ;; > ERROR: In procedure execl:
           ;; > In procedure execl: No such file or directory
           ;; > iptables v1.8.8 (legacy): can't initialize iptables table `nat': Table does not exist (do you need to insmod?)
           ;; > Perhaps iptables or your kernel needs to be upgraded.

           ;; This declares lobo's subuid and subgid ranges, and puts podman in
           ;; the system profile. The containers below rely on both.
           ;;
           ;; Do not move these numbers. /marak/podman-storage holds image
           ;; layers owned by uids inside this range; shifting it makes every
           ;; one of them unreadable.
           (service rootless-podman-service-type
                    (rootless-podman-configuration
                     (subgids
                      (list (subid-range (name "lobo")
                                         (start {{ gak_subid_start }})
                                         (count {{ gak_subid_count }}))))
                     (subuids
                      (list (subid-range (name "lobo")
                                         (start {{ gak_subid_start }})
                                         (count {{ gak_subid_count }}))))))

{% if gak_aiagent_host_enabled | bool %}
           (service aiagent-host-service-type
                    (list (plain-file "gak-aiagent-deploy.pub"
                                      "{{ gak_aiagent_deploy_public_key | trim }}\n")
                          (plain-file "gak-aiagent-shell.pub"
                                      "{{ gak_aiagent_shell_public_key | trim }}\n")))
{% endif %}

{% if 'nextcloud' in gak_applications %}
{{ lookup('ansible.builtin.template', role_path ~ '/../gak_nextcloud/templates/jobs.scm.j2') }}
{% endif %}
           ;; Elogind owns the lingering operator's runtime directory. Compose
           ;; starts only after its ownership and mode are ready.
           (simple-service
            'gak-operator-runtime
            shepherd-root-service-type
            (list
             (shepherd-service
              (provision '(gak-operator-runtime))
              (requirement '(user-processes elogind))
              (one-shot? #t)
              (start #~(lambda _
                         (zero? (system* #$%gak-operator-runtime-program))))
              (stop #~(const #f))
              (respawn? #f))))

           ;; Compose owns application containers and networks as the login user.
           ;; Shepherd keeps one long-lived process so its stop destructor waits
           ;; for the helper's graceful Compose stop sequence.
           (simple-service
            'gak-compose
            shepherd-root-service-type
            (list
             (shepherd-service
              (provision '(gak-compose))
              (requirement '(user-processes
                             cgroups2-fs-owner
                             cgroups2-limits
                             rootless-podman-shared-root-fs
                             elogind
                             gak-operator-runtime
                             networking
                             file-system-/marak
                             file-system-/media))
              (documentation
               "Start the user-owned Compose projects selected for boot.")
              (start
               #~(make-forkexec-constructor
                (list "{{ gak_services_bin_dir }}/gak-compose-lifecycle" "run")
                #:user "lobo"
                #:group "lobo"
                #:supplementary-groups '("wheel" "netdev" "cgroup" "users" "media")
                #:directory "{{ ansible_facts['user_dir'] }}"
                #:file-creation-mask #o022
                #:environment-variables
                '("HOME={{ ansible_facts['user_dir'] }}"
                  "XDG_RUNTIME_DIR=/run/user/1000"
                  "PATH=/run/privileged/bin:{{ ansible_facts['user_dir'] }}/.guix-home/profile/bin:{{ ansible_facts['user_dir'] }}/.guix-profile/bin:/run/current-system/profile/bin:/usr/bin:/bin")
                ))
              (stop #~(make-kill-destructor #:grace-period 1800))
              (respawn? #f)))))
{% if gak_git_hub_enabled | bool %}
          (git-hub-services %git-hub-config)
{% endif %}
          ;; This is the default list of services we are appending to.
          (modify-services %base-services
                           (guix-service-type config =>
                                              (guix-configuration
                                               (inherit config)
                                               (substitute-urls
                                                (append (list "https://substitutes.nonguix.org")
                                                        %default-substitute-urls))
                                               (authorized-keys
                                                (append (list (plain-file
                                                               "lobo-ak.pub"
                                                               "{{ ak_signing_key_sexp }}")
                                                              (plain-file
                                                               "alarm-alarm.pub"
                                                               "(public-key (ecc (curve Ed25519) (q #3B36F7F2F3DB2B16C5A0AF4299065B402E7A4701C23FB9DC0229D7EEC94534D4#)))")
                                                              %plain-nonguix-signing-key-pub)
                                                        %default-authorized-guix-keys))
                                               (build-machines
                                                (list #~(build-machine
                                                         (name "{{ ak_fqdn }}")
                                                         (systems (list "aarch64-linux" "x86_64-linux"))
                                                         (host-key "{{ (ak_ssh_host_key.content | b64decode).split()[:2] | join(' ') }}")
                                                         (port {{ ssh_port }})
                                                         (user "lobo")
                                                         (parallel-builds 6)
                                                         (overload-threshold 0.8)
                                                         (speed 2.)
                                                         (private-key "/home/lobo/.ssh/id_ed25519"))))
                                               )))))

 (bootloader (bootloader-configuration
              (bootloader grub-efi-bootloader)
              (targets (list "/boot/efi"))
              (keyboard-layout keyboard-layout)))

 (file-systems (cons* (file-system
                       (mount-point "/")
                       (device (uuid
                                "e1a3aa25-ad71-4698-9d42-46cc1c766a9a"
                                'ext4))
                       (type "ext4"))

                      (file-system
                       (mount-point "/turak")
                       (device (file-system-label "IRONWOLF16TB20230725"))
                       (type "btrfs")
                       (options "compress=zstd:15,subvol=/@")
                       (check? #t)
                       (mount? #t)
                       (create-mount-point? #t))

                      (file-system
                       (mount-point "/marak")
                       (device (file-system-label "EXOS16TB20241111"))
                       (type "btrfs")
                       (options "compress=zstd,subvol=/@")
                       (check? #t)
                       (mount? #t)
                       (create-mount-point? #t))

                      (file-system
                       (mount-point "/media")
                       (device (file-system-label "EXOS16TB20241111"))
                       (type "btrfs")
                       (options "subvol=/@media-server")
                       (check? #t)
                       (mount? #t)
                       (create-mount-point? #t))

                      (file-system
                       (mount-point "/boot/efi")
                       (device (uuid "1B4D-DAED"
                                     'fat32))
                       (type "vfat")) %base-file-systems)))
