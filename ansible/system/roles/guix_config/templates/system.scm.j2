;;; Managed by Ansible (role: guix_config) — edit the role, not this file.
;;;
;;; Ansible ships this file; it never reconfigures gak. A bad expression here
;;; can leave the host unbootable, and a reconfigure is slow enough to want a
;;; human watching it. Apply by hand, on the host:
;;;
;;;   sudo guix system reconfigure ~/.config/guix/system.scm
;;;
;;; /etc/config.scm is the installer's original and is not used by anything.

(use-modules (gnu)
             (gnu system nss)
             (nongnu packages linux)
             (nongnu system linux-initrd)
             (gnu packages shells)
             (gnu services nfs)
             (gnu system accounts)
             )

(use-service-modules base          ; hosts-service-type, for the static LAN entries
                     cups
                     desktop
                     networking
                     ssh
                     shepherd
                     containers
                     avahi)

(define %plain-nonguix-signing-key-pub
  (plain-file "nonguix.pub"
              (string-append "(public-key\n"
                             "(ecc (curve Ed25519)\n"
                             "(q #C1FD53E5D4CE971933EC50C9F307AE2171A2D3B52C804642A7A35F84F3A4EA98#)))")))

(operating-system
 ;; kernel & microcode
 (kernel linux)
 (initrd microcode-initrd)
 (firmware (list linux-firmware))

 (locale "en_US.utf8")
 (timezone "America/Sao_Paulo")
 (keyboard-layout (keyboard-layout "us"))
 (host-name "gak")

 (users (cons* (user-account
                (name "lobo")
                (group "lobo")
                (shell (file-append zsh "/bin/zsh"))
                (home-directory "/home/lobo")
                (supplementary-groups '("wheel" "netdev" "cgroup"
                                        "users" "media")))
               %base-user-accounts))
 (groups (append (list
                  (user-group (name "lobo") (id 1000))
                  (user-group (name "media") (id 134) (system? #t))
                  ) %base-groups))

 (packages (append (map specification->package
                        (list "git"
                              "eza"
                              "fd"
                              "bat"
                              "ripgrep"
                              "rsync"))
                   %base-packages))

 ;; To search for available services, run 'guix system search KEYWORD'
 (services
  (append (list
           (service openssh-service-type)
           (service dhcpcd-service-type)
           (service ntp-service-type)
           (service avahi-service-type)

           ;; The LAN, written down.
           ;;
           ;; This machine's only nameserver is pak, and pak's resolver runs in
           ;; a container on pak. So DNS for the house depends on pak being up,
           ;; and the NFS exports below are keyed on a hostname — which made
           ;; serving files to ak depend on a Raspberry Pi that is not involved
           ;; in serving files to ak. A power cut took pak down and nfsd came up
           ;; with nothing exported, needing a hand to recover.
           ;;
           ;; Static entries break that: exportfs resolves these three names out
           ;; of /etc/hosts without a packet leaving the machine, so the NAS
           ;; keeps serving whether or not pak has finished booting, or is
           ;; booting at all. Nothing to poll and nothing to wait for.
           ;;
           ;; DNS for everything else still goes to pak, and still fails when
           ;; pak is down. That is fine — nothing here needs it.
           (simple-service 'lan-hosts hosts-service-type
                           (list (host "{{ ak_address }}" "{{ ak_fqdn }}" '("ak"))
                                 (host "{{ gak_address }}" "{{ gak_fqdn }}" '("gak"))
                                 (host "{{ pak_address }}" "{{ pak_fqdn }}" '("pak"))))

           ;; Exports are read once, when nfsd starts. After changing them:
           ;;   sudo herd restart nfs
           ;; and to see what is actually exported right now:
           ;;   guix shell nfs-utils -- sudo exportfs -v
           (service nfs-service-type
                    (nfs-configuration
                     (exports '(("/turak" "{{ ak_fqdn }}(rw,no_all_squash,root_squash)")
                                ("/media" "{{ ak_fqdn }}(rw,no_all_squash,root_squash)")
                                ("/marak" "{{ ak_fqdn }}(rw,no_all_squash,root_squash)")))))


           (service elogind-service-type)
           ;; [[https://www.reddit.com/r/GUIX/comments/15vb7la/xdg_runtime_dir/][XDG_RUNTIME_DIR : r/GUIX]]
           (service iptables-service-type)
           ;; Enables iptables for podman
           ;; Fixes:
           ;; > Error: unable to start container "...": netavark: code: 3, msg: Backtrace:
           ;; > ...
           ;; > ERROR: In procedure execl:
           ;; > In procedure execl: No such file or directory
           ;; > iptables v1.8.8 (legacy): can't initialize iptables table `nat': Table does not exist (do you need to insmod?)
           ;; > Perhaps iptables or your kernel needs to be upgraded.

           (service rootless-podman-service-type
                    (rootless-podman-configuration
                     (subgids
                      (list (subid-range (name "lobo") (start 100000) (count 65536))))
                     (subuids
                      (list (subid-range (name "lobo") (start 100000) (count 65536)))))))
          ;; This is the default list of services we are appending to.
          (modify-services %base-services
                           (guix-service-type config =>
                                              (guix-configuration
                                               (inherit config)
                                               (substitute-urls
                                                (append (list "https://substitutes.nonguix.org")
                                                        %default-substitute-urls))
                                               (authorized-keys
                                                (append (list (plain-file
                                                               "lobo-ak.pub"
                                                               "(public-key (ecc (curve Ed25519) (q #844B8666C9E0988CE066D33F6E48942E4831104001C061E97DC8BA6C6A145515#)))")
                                                              (plain-file
                                                               "alarm-alarm.pub"
                                                               "(public-key (ecc (curve Ed25519) (q #3B36F7F2F3DB2B16C5A0AF4299065B402E7A4701C23FB9DC0229D7EEC94534D4#)))")
                                                              %plain-nonguix-signing-key-pub)
                                                        %default-authorized-guix-keys))
                                               (build-machines
                                                (list #~(build-machine
                                                         (name "{{ ak_fqdn }}")
                                                         (systems (list "aarch64-linux" "x86_64-linux"))
                                                         (host-key "ssh-ed25519 <ak-ssh-host-key>")
                                                         (port {{ ssh_port }})
                                                         (user "lobo")
                                                         (parallel-builds 6)
                                                         (overload-threshold 0.8)
                                                         (speed 2.)
                                                         (private-key "/home/lobo/.ssh/id_ed25519"))))
                                               )))))

 (bootloader (bootloader-configuration
              (bootloader grub-efi-bootloader)
              (targets (list "/boot/efi"))
              (keyboard-layout keyboard-layout)))

 (file-systems (cons* (file-system
                       (mount-point "/")
                       (device (uuid
                                "e1a3aa25-ad71-4698-9d42-46cc1c766a9a"
                                'ext4))
                       (type "ext4"))

                      (file-system
                       (mount-point "/turak")
                       (device (file-system-label "IRONWOLF16TB20230725"))
                       (type "btrfs")
                       (options "compress=zstd:15,subvol=/@")
                       (check? #t)
                       (mount? #t)
                       (create-mount-point? #t))

                      (file-system
                       (mount-point "/marak")
                       (device (file-system-label "EXOS16TB20241111"))
                       (type "btrfs")
                       (options "compress=zstd,subvol=/@")
                       (check? #t)
                       (mount? #t)
                       (create-mount-point? #t))

                      (file-system
                       (mount-point "/media")
                       (device (file-system-label "EXOS16TB20241111"))
                       (type "btrfs")
                       (options "subvol=/@media-server")
                       (check? #t)
                       (mount? #t)
                       (create-mount-point? #t))

                      (file-system
                       (mount-point "/boot/efi")
                       (device (uuid "1B4D-DAED"
                                     'fat32))
                       (type "vfat")) %base-file-systems)))
