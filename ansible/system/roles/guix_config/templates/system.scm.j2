;;; Managed by Ansible (role: guix_config) — edit the role, not this file.
;;;
;;; Ansible ships this file; it never reconfigures gak. A bad expression here
;;; can leave the host unbootable, and a reconfigure is slow enough to want a
;;; human watching it. Apply by hand, on the host:
;;;
;;;   sudo guix system reconfigure ~/.config/guix/system.scm
;;;
;;; /etc/config.scm is the installer's original and is not used by anything.

(use-modules (gnu)
             (gnu system nss)
             (nongnu packages linux)
             (nongnu system linux-initrd)
             (gnu packages shells)
             (gnu services nfs)
             (gnu system accounts)
             ;; Guix upstream packages Tailscale's Go dependencies but not
             ;; Tailscale, so `tailscaled` comes from the rosenthal channel
             ;; already listed in channels.scm. Not a `use-service-modules`
             ;; entry: that form prefixes `gnu services`.
             (rosenthal services networking)
             ((11xx packages networking) #:prefix local:)
             )

(use-service-modules base          ; hosts-service-type, for the static LAN entries
                     cups
                     desktop
                     networking
                     ssh
                     shepherd
                     containers
                     mcron
                     avahi)

(define %plain-nonguix-signing-key-pub
  (plain-file "nonguix.pub"
              (string-append "(public-key\n"
                             "(ecc (curve Ed25519)\n"
                             "(q #C1FD53E5D4CE971933EC50C9F307AE2171A2D3B52C804642A7A35F84F3A4EA98#)))")))

(operating-system
 ;; kernel & microcode
 (kernel linux)
 (initrd microcode-initrd)
 (firmware (list linux-firmware))

 (locale "en_US.utf8")
 (timezone "America/Sao_Paulo")
 (keyboard-layout (keyboard-layout "us"))
 (host-name "gak")

 (users (cons* (user-account
                (name "lobo")
                (group "lobo")
                (shell (file-append zsh "/bin/zsh"))
                (home-directory "/home/lobo")
                (supplementary-groups '("wheel" "netdev" "cgroup"
                                        "users" "media")))
               %base-user-accounts))
 (groups (append (list
                  (user-group (name "lobo") (id 1000))
                  (user-group (name "media") (id 134) (system? #t))
                  ) %base-groups))

 (packages (append (map specification->package
                        (list "git"
                              "eza"
                              "fd"
                              "bat"
                              "ripgrep"
                              "rsync"
                              "restic"))
                   %base-packages))

 ;; To search for available services, run 'guix system search KEYWORD'
 (services
  (append (list
           (service openssh-service-type)
           (service dhcpcd-service-type)
           (service ntp-service-type)
           (service avahi-service-type)

           ;; The LAN, written down.
           ;;
           ;; This machine's only nameserver is pak, and pak's resolver runs in
           ;; a container on pak. So DNS for the house depends on pak being up,
           ;; and the NFS exports below are keyed on a hostname — which made
           ;; serving files to ak depend on a Raspberry Pi that is not involved
           ;; in serving files to ak. A power cut took pak down and nfsd came up
           ;; with nothing exported, needing a hand to recover.
           ;;
           ;; Static entries break that: exportfs resolves these three names out
           ;; of /etc/hosts without a packet leaving the machine, so the NAS
           ;; keeps serving whether or not pak has finished booting, or is
           ;; booting at all. Nothing to poll and nothing to wait for.
           ;;
           ;; DNS for everything else still goes to pak, and still fails when
           ;; pak is down. That is fine — nothing here needs it.
           (simple-service 'lan-hosts hosts-service-type
                           (list (host "{{ ak_address }}" "{{ ak_fqdn }}" '("ak"))
                                 (host "{{ gak_address }}" "{{ gak_fqdn }}" '("gak"))
                                 (host "{{ pak_address }}" "{{ pak_fqdn }}" '("pak"))))

           ;; Exports are read once, when nfsd starts. After changing them:
           ;;   sudo herd restart nfs
           ;; and to see what is actually exported right now:
           ;;   guix shell nfs-utils -- sudo exportfs -v
           (service nfs-service-type
                    (nfs-configuration
                     (exports '(("/turak" "{{ ak_fqdn }}(rw,no_all_squash,root_squash)")
                                ("/media" "{{ ak_fqdn }}(rw,no_all_squash,root_squash)")
                                ("/marak" "{{ ak_fqdn }}(rw,no_all_squash,root_squash)")))))


           ;; Reaches gak's services from outside the house without forwarding a
           ;; port or exposing anything to the internet. The daemon runs with no
           ;; identity of its own until it is authenticated once, by hand, on
           ;; the host:
           ;;
           ;;   sudo tailscale up
           ;;
           ;; That prints a URL to approve the machine, and the resulting node
           ;; key is kept under /var/lib/tailscale. It survives reconfigures, so
           ;; this is a first-boot step rather than a recurring one.
           ;;
           ;; `-no-logs-no-support` is the default here: it stops the daemon
           ;; uploading logs to Tailscale, and gives up their technical support
           ;; in exchange, which is the trade this machine wants.
           (service tailscale-service-type
                    (tailscale-configuration
                     (tailscale local:tailscale)))

           (service elogind-service-type)
           ;; [[https://www.reddit.com/r/GUIX/comments/15vb7la/xdg_runtime_dir/][XDG_RUNTIME_DIR : r/GUIX]]
           (service iptables-service-type)
           ;; Enables iptables for podman
           ;; Fixes:
           ;; > Error: unable to start container "...": netavark: code: 3, msg: Backtrace:
           ;; > ...
           ;; > ERROR: In procedure execl:
           ;; > In procedure execl: No such file or directory
           ;; > iptables v1.8.8 (legacy): can't initialize iptables table `nat': Table does not exist (do you need to insmod?)
           ;; > Perhaps iptables or your kernel needs to be upgraded.

           ;; This declares lobo's subuid and subgid ranges, and puts podman in
           ;; the system profile. The containers below rely on both.
           ;;
           ;; Do not move these numbers. /marak/podman-storage holds image
           ;; layers owned by uids inside this range; shifting it makes every
           ;; one of them unreadable.
           (service rootless-podman-service-type
                    (rootless-podman-configuration
                     (subgids
                      (list (subid-range (name "lobo")
                                         (start {{ gak_subid_start }})
                                         (count {{ gak_subid_count }}))))
                     (subuids
                      (list (subid-range (name "lobo")
                                         (start {{ gak_subid_start }})
                                         (count {{ gak_subid_count }}))))))

           ;; A database dump and the application files enter one encrypted
           ;; Restic snapshot every day. The command acquires its own lock,
           ;; places Nextcloud in maintenance mode, enforces retention and
           ;; checks the repository before returning.
           (service mcron-service-type
                    (mcron-configuration
                     (jobs
                      (list #~(job "30 3 * * *"
                                   "/home/lobo/.local/bin/gak-nextcloud-backup"
                                   #:user "lobo")))))

           ;; Every container on gak.
           ;;
           ;; They are declared here rather than in a compose file because this
           ;; machine has no systemd. A `.service` unit under ~/.config/systemd
           ;; is a file nothing reads, and a Guix Home Shepherd service would
           ;; not start until someone logged in — no good for a headless server
           ;; that should come back by itself after a power cut. oci-service-type
           ;; provisions system Shepherd services, so `herd status` lists them
           ;; and they start at boot.
           ;;
           ;; They still run rootless, as lobo: the runtime is podman and the
           ;; user field says so. Ansible owns what these containers read and
           ;; write — service state, secrets, recyclarr's configuration — and
           ;; this file owns the containers themselves.
           ;;
           ;; Nothing secret belongs below. This file is built into /gnu/store,
           ;; which is world-readable, so a password written here is published
           ;; to every user on the machine. Where a container needs one, Ansible
           ;; deploys it to a 0600 file and the container reads it through an
           ;; image-specific *_FILE variable.
           ;; Built by calling oci-configuration->shepherd-services directly,
           ;; rather than by adding oci-service-type to this list.
           ;;
           ;; That service type also extends account-service-type with a
           ;; user-account for whatever its `user` field names. lobo already has
           ;; an account above, so the result is two lobo records — the second
           ;; one in group "users" with /sbin/nologin — and /etc/passwd is
           ;; written from that list without deduplication. Calling the builder
           ;; takes the Shepherd services and leaves the account alone.
           ;;
           ;; Its other extensions are already covered:
           ;; rootless-podman-service-type above puts podman in the system
           ;; profile and declares lobo's subuid and subgid ranges.
           ;;
           ;; These start at boot without anyone logging in, which rootless
           ;; podman needs /run/user/1000 for. elogind creates it because lobo
           ;; is a lingering user. That is host state, not configuration:
           ;;
           ;;   sudo loginctl enable-linger lobo
           (simple-service
            'gak-containers
            shepherd-root-service-type
            (oci-configuration->shepherd-services
             (oci-configuration
                     (runtime 'podman)
                     (user "lobo")

                     (networks
                      (list (oci-network-configuration (name "starrs_net"))
                            (oci-network-configuration (name "services_net"))
                            (oci-network-configuration (name "nextcloud_net"))))

                     (containers
                      (list
                       ;; --- The media stack ------------------------------
                       ;;
                       ;; Written out one container at a time rather than
                       ;; folded together. These differ in small ways that a
                       ;; shared abstraction would hide, and the cost of
                       ;; repetition here is lower than the cost of reading
                       ;; around it.
                       ;;
                       ;; The idmaps below map container root to the first
                       ;; subuid and pass the media group through to itself, so
                       ;; what the containers write into /media stays readable
                       ;; over NFS. They are carried over unchanged from the
                       ;; compose file this replaces, which ran on a different
                       ;; host; they have never run on gak, so this is the part
                       ;; of the media stack most likely to want adjusting the
                       ;; first time it starts.
                       (oci-container-configuration
                        (provision "sabnzbd")
                        (image "lscr.io/linuxserver/sabnzbd:latest")
                        (network "starrs_net")
                        (ports (list '("9090" . "8080")))
                        (volumes
                         (list '("/media/.config/sabnzbd/config" . "/config")
                               '("/media/Media" . "/Media")))
                        (environment
                         (list '("PUID" . "{{ gak_media_uid }}")
                               '("PGID" . "{{ gak_media_gid }}")
                               '("UMASK" . "002")
                               '("TZ" . "{{ gak_timezone }}")))
                        (extra-arguments
                         (list "--uidmap" "0:1:1"
                               "--gidmap" "0:1:1"
                               "--gidmap" "{{ gak_media_gid }}:{{ gak_media_gid }}:1")))

                       (oci-container-configuration
                        (provision "prowlarr")
                        (image "lscr.io/linuxserver/prowlarr:latest")
                        (network "starrs_net")
                        (ports (list '("8888" . "9696")))
                        (volumes
                         (list '("/media/.config/prowlarr/config" . "/config")))
                        (environment
                         (list '("PUID" . "{{ gak_media_uid }}")
                               '("PGID" . "{{ gak_media_gid }}")
                               '("UMASK" . "002")
                               '("TZ" . "{{ gak_timezone }}")))
                        (extra-arguments
                         (list "--uidmap" "0:1:1"
                               "--gidmap" "0:1:1"
                               "--gidmap" "{{ gak_media_gid }}:{{ gak_media_gid }}:1")))

                       (oci-container-configuration
                        (provision "sonarr")
                        (image "ghcr.io/hotio/sonarr")
                        (network "starrs_net")
                        (ports (list '("{{ gak_sonarr_port }}" . "8989")))
                        (volumes
                         (list '("/media/.config/sonarr/config" . "/config")
                               '("/media/Media" . "/Media")))
                        (environment
                         (list '("PUID" . "{{ gak_media_uid }}")
                               '("PGID" . "{{ gak_media_gid }}")
                               '("UMASK" . "002")
                               '("TZ" . "{{ gak_timezone }}")))
                        (extra-arguments
                         (list "--uidmap" "0:1:1"
                               "--gidmap" "0:1:1"
                               "--gidmap" "{{ gak_media_gid }}:{{ gak_media_gid }}:1")))

                       (oci-container-configuration
                        (provision "radarr")
                        (image "ghcr.io/hotio/radarr")
                        (network "starrs_net")
                        (ports (list '("8787" . "7878")))
                        (volumes
                         (list '("/media/.config/radarr/config" . "/config")
                               '("/media/Media" . "/Media")))
                        (environment
                         (list '("PUID" . "{{ gak_media_uid }}")
                               '("PGID" . "{{ gak_media_gid }}")
                               '("UMASK" . "002")
                               '("TZ" . "{{ gak_timezone }}")))
                        (extra-arguments
                         (list "--uidmap" "0:1:1"
                               "--gidmap" "0:1:1"
                               "--gidmap" "{{ gak_media_gid }}:{{ gak_media_gid }}:1")))

                       ;; No PUID/PGID: this image runs as whoever starts it,
                       ;; so the idmaps alone decide what it writes as.
                       (oci-container-configuration
                        (provision "jellyfin")
                        (image "jellyfin/jellyfin")
                        (network "starrs_net")
                        (ports (list '("9292" . "8096")))
                        (volumes
                         (list '("/media/.config/jellyfin/config" . "/config")
                               '("/media/.config/jellyfin/cache" . "/cache")
                               '("/media/Media" . "/Media")))
                        (extra-arguments
                         (list "--uidmap" "0:1:1"
                               "--gidmap" "0:1:1"
                               "--gidmap" "{{ gak_media_gid }}:{{ gak_media_gid }}:1")))

                       ;; The web UI is told its own port because it is
                       ;; published unmapped; the torrenting port is mapped and
                       ;; so differs inside and out.
                       (oci-container-configuration
                        (provision "qbittorrent")
                        (image "lscr.io/linuxserver/qbittorrent:latest")
                        (network "starrs_net")
                        (ports (list '("9191" . "9191")
                                     '("12671" . "6881")
                                     "12671:6881/udp"))
                        (volumes
                         (list '("/media/.config/qbittorrent/config" . "/config")
                               '("/media/Media" . "/Media")))
                        (environment
                         (list '("PUID" . "{{ gak_media_uid }}")
                               '("PGID" . "{{ gak_media_gid }}")
                               '("UMASK" . "002")
                               '("TZ" . "{{ gak_timezone }}")
                               '("WEBUI_PORT" . "9191")
                               '("TORRENTING_PORT" . "6881")))
                        (extra-arguments
                         (list "--uidmap" "0:1:1"
                               "--gidmap" "0:1:1"
                               "--gidmap" "{{ gak_media_gid }}:{{ gak_media_gid }}:1")))

                       ;; recyclarr is a batch job, not a server: it syncs Trash
                       ;; Guides custom formats into sonarr and exits. Hence no
                       ;; ports, no idmaps, and `auto-start? #f` — a container
                       ;; that exits on purpose would otherwise read as a
                       ;; service that failed at every boot. Run it when wanted:
                       ;;
                       ;;   sudo herd start recyclarr
                       ;;
                       ;; https://recyclarr.dev/wiki/installation/docker/
                       (oci-container-configuration
                        (provision "recyclarr")
                        (image "ghcr.io/recyclarr/recyclarr")
                        (network "starrs_net")
                        (container-user "{{ gak_media_uid }}:{{ gak_media_gid }}")
                        (volumes
                         (list '("/media/.config/recyclarr" . "/config")))
                        (environment
                         (list '("TZ" . "{{ gak_timezone }}")))
                        (auto-start? #f))

                       ;; --- General services -----------------------------
                       ;;
                       ;; Koito receives scrobbles over the ListenBrainz
                       ;; submission API and keeps the listening history in a
                       ;; SQLite file under /etc/koito. No database service, no
                       ;; cache, no broker.
                       ;;
                       ;; A scrobbler that sends only an artist and a title is
                       ;; resolved against the public MusicBrainz API at request
                       ;; time rather than from a local replica.
                       ;;
                       ;; No idmaps: nothing here writes into the NFS-exported
                       ;; media tree, so the only thing that matters is that the
                       ;; files stay readable by lobo, which they are.
                       ;;
                       ;; The admin password is not here. Ansible writes it to a
                       ;; 0600 file that Koito reads through the *_FILE
                       ;; convention, because this file is world-readable in the
                       ;; store.
                       (oci-container-configuration
                        (provision "koito")
                        (image "gabehf/koito:{{ gak_koito_version }}")
                        (network "services_net")
                        (ports (list '("127.0.0.1:{{ gak_koito_port }}" . "4110")))
                        (volumes
                         (list '("/home/lobo/services/koito" . "/etc/koito")
                               '("/home/lobo/services/koito/secrets" . "/secrets")))
                        (environment
                         (list '("KOITO_DEFAULT_USERNAME" . "{{ gak_koito_admin_user }}")
                               '("KOITO_DEFAULT_PASSWORD_FILE" . "/secrets/default-password")
                               '("KOITO_FORCE_TZ" . "{{ gak_timezone }}")))
                        (respawn? #t))

                       ;; Nextcloud keeps the whole application tree on the
                       ;; NVMe, with PostgreSQL as its durable database and
                       ;; Redis for distributed cache and file locking. Only
                       ;; Apache reaches the host, on loopback; named Tailscale
                       ;; Services are the sole ingress.
                       (oci-container-configuration
                        (provision "nextcloud-db")
                        (image "docker.io/library/postgres:{{ gak_nextcloud_postgres_version }}@{{ gak_nextcloud_postgres_image_digest }}")
                        (network "nextcloud_net")
                        (volumes
                         (list '("/home/lobo/services/nextcloud/postgres" . "/var/lib/postgresql/data")
                               '("/home/lobo/services/nextcloud/secrets" . "/run/secrets/nextcloud:ro")))
                        (environment
                         (list '("POSTGRES_DB" . "nextcloud")
                               '("POSTGRES_USER" . "nextcloud")
                               '("POSTGRES_PASSWORD_FILE" . "/run/secrets/nextcloud/postgres-password")))
                        (respawn? #t))

                       (oci-container-configuration
                        (provision "nextcloud-redis")
                        (image "docker.io/library/redis:{{ gak_nextcloud_redis_version }}@{{ gak_nextcloud_redis_image_digest }}")
                        (network "nextcloud_net")
                        (command (list "redis-server" "/usr/local/etc/redis/redis.conf"))
                        (volumes
                         (list '("/home/lobo/services/nextcloud/secrets/redis.conf" . "/usr/local/etc/redis/redis.conf:ro")))
                        (respawn? #t))

                       (oci-container-configuration
                        (provision "nextcloud")
                        (image "docker.io/library/nextcloud:{{ gak_nextcloud_version }}-apache@{{ gak_nextcloud_image_digest }}")
                        (requirement '(nextcloud-db nextcloud-redis))
                        (network "nextcloud_net")
                        (ports (list '("127.0.0.1:{{ gak_nextcloud_port }}" . "80")))
                        (volumes
                         (list '("/home/lobo/services/nextcloud/html" . "/var/www/html")
                               '("/home/lobo/services/nextcloud/secrets" . "/run/secrets/nextcloud:ro")))
                        (environment
                         (list '("POSTGRES_HOST" . "nextcloud-db")
                               '("POSTGRES_DB" . "nextcloud")
                               '("POSTGRES_USER" . "nextcloud")
                               '("POSTGRES_PASSWORD_FILE" . "/run/secrets/nextcloud/postgres-password")
                               '("REDIS_HOST" . "nextcloud-redis")
                               '("REDIS_HOST_PASSWORD_FILE" . "/run/secrets/nextcloud/redis-password")
                               '("NEXTCLOUD_ADMIN_USER" . "{{ gak_nextcloud_admin_user }}")
                               '("NEXTCLOUD_ADMIN_PASSWORD_FILE" . "/run/secrets/nextcloud/admin-password")
                               '("NEXTCLOUD_TRUSTED_DOMAINS" . "{{ gak_nextcloud_hostname }}")
                               '("TRUSTED_PROXIES" . "127.0.0.1")
                               '("APACHE_DISABLE_REWRITE_IP" . "1")
                               '("OVERWRITEHOST" . "{{ gak_nextcloud_hostname }}")
                               '("OVERWRITEPROTOCOL" . "https")
                               '("OVERWRITECLIURL" . "https://{{ gak_nextcloud_hostname }}")
                               '("PHP_MEMORY_LIMIT" . "1G")
                               '("PHP_UPLOAD_LIMIT" . "10G")))
                        (respawn? #t))

                       (oci-container-configuration
                        (provision "nextcloud-cron")
                        (image "docker.io/library/nextcloud:{{ gak_nextcloud_version }}-apache@{{ gak_nextcloud_image_digest }}")
                        (requirement '(nextcloud nextcloud-db nextcloud-redis))
                        (network "nextcloud_net")
                        (entrypoint "/cron.sh")
                        (volumes
                         (list '("/home/lobo/services/nextcloud/html" . "/var/www/html")))
                        (respawn? #t))))))))
          ;; This is the default list of services we are appending to.
          (modify-services %base-services
                           (guix-service-type config =>
                                              (guix-configuration
                                               (inherit config)
                                               (substitute-urls
                                                (append (list "https://substitutes.nonguix.org")
                                                        %default-substitute-urls))
                                               (authorized-keys
                                                (append (list (plain-file
                                                               "lobo-ak.pub"
                                                               "{{ ak_signing_key_sexp }}")
                                                              (plain-file
                                                               "alarm-alarm.pub"
                                                               "(public-key (ecc (curve Ed25519) (q #3B36F7F2F3DB2B16C5A0AF4299065B402E7A4701C23FB9DC0229D7EEC94534D4#)))")
                                                              %plain-nonguix-signing-key-pub)
                                                        %default-authorized-guix-keys))
                                               (build-machines
                                                (list #~(build-machine
                                                         (name "{{ ak_fqdn }}")
                                                         (systems (list "aarch64-linux" "x86_64-linux"))
                                                         (host-key "ssh-ed25519 <ak-ssh-host-key>")
                                                         (port {{ ssh_port }})
                                                         (user "lobo")
                                                         (parallel-builds 6)
                                                         (overload-threshold 0.8)
                                                         (speed 2.)
                                                         (private-key "/home/lobo/.ssh/id_ed25519"))))
                                               )))))

 (bootloader (bootloader-configuration
              (bootloader grub-efi-bootloader)
              (targets (list "/boot/efi"))
              (keyboard-layout keyboard-layout)))

 (file-systems (cons* (file-system
                       (mount-point "/")
                       (device (uuid
                                "e1a3aa25-ad71-4698-9d42-46cc1c766a9a"
                                'ext4))
                       (type "ext4"))

                      (file-system
                       (mount-point "/turak")
                       (device (file-system-label "IRONWOLF16TB20230725"))
                       (type "btrfs")
                       (options "compress=zstd:15,subvol=/@")
                       (check? #t)
                       (mount? #t)
                       (create-mount-point? #t))

                      (file-system
                       (mount-point "/marak")
                       (device (file-system-label "EXOS16TB20241111"))
                       (type "btrfs")
                       (options "compress=zstd,subvol=/@")
                       (check? #t)
                       (mount? #t)
                       (create-mount-point? #t))

                      (file-system
                       (mount-point "/media")
                       (device (file-system-label "EXOS16TB20241111"))
                       (type "btrfs")
                       (options "subvol=/@media-server")
                       (check? #t)
                       (mount? #t)
                       (create-mount-point? #t))

                      (file-system
                       (mount-point "/boot/efi")
                       (device (uuid "1B4D-DAED"
                                     'fat32))
                       (type "vfat")) %base-file-systems)))
