             ;; Tailscale, so `tailscaled` comes from the rosenthal channel
             ;; already listed in channels.scm. Not a `use-service-modules`
             ;; entry: that form prefixes `gnu services`.
             (rosenthal services networking)
             ((11xx packages networking) #:prefix local:)
             )

(use-service-modules base          ; hosts-service-type, for the static LAN entries
                     cups
                     desktop
                     networking
                     ssh
                     shepherd
                     containers
                     mcron
