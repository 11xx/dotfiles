[Unit]
# Managed by Ansible (role: gak_media) — edit the role, not this file.
Description=Media stack: sabnzbd, prowlarr, sonarr, radarr, jellyfin, qbittorrent, recyclarr
After=network-online.target
Wants=network-online.target
Requires=podman.socket

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ gak_media_dir }}
Environment=PODMAN_SYSTEMD_UNIT=%n
# `down` first so restarting after a config change recreates the containers
# rather than finding them already up and doing nothing.
ExecStart=podman-compose down
ExecStart=podman-compose up -d
ExecStop=podman-compose down
# The compose file pins `pull_policy: missing`, so images are fetched once and
# then never again without being asked. Pulling seven of them on first start is
# what the timeout is for.
TimeoutStartSec=1800

[Install]
WantedBy=default.target
