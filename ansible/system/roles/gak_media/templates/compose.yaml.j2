---
# Managed by Ansible (role: gak_media) — edit the role, not this file.
#
# Was tangled out of /media/README.org, which had drifted: the Org source still
# had the network stanzas commented out that the deployed file was running with.
# What is here is the deployed file, which is the one that was known to work.
#
# Deliberately repetitive rather than folded into a YAML anchor. `x-podman.*`
# are extension fields, and whether an implementation resolves them through a
# merge key is not something this file should be the test of.
name: starrs
services:
  sabnzbd:
    image: lscr.io/linuxserver/sabnzbd:latest
    container_name: sabnzbd
    environment:
      - PUID={{ gak_media_uid }}
      - PGID={{ gak_media_gid }}
      - UMASK=002
      - TZ={{ gak_media_timezone }}
    # Rootless podman maps the login user to container root, so an unmapped
    # image writes files owned by a subuid nothing on the host can read. These
    # map container root to the first subuid and pass the media group through to
    # itself, so what the containers write stays readable over NFS.
    x-podman.uidmap:
        - "0:1:1"
    x-podman.gidmap:
        - "0:1:1"
        - "{{ gak_media_gid }}:{{ gak_media_gid }}:1"
    volumes:
      - .config/sabnzbd/config:/config
      - shared_volume:/Media
      # - /path/to/incomplete/downloads:/incomplete-downloads #optional
    ports:
      - 9090:8080
    restart: unless-stopped
    pull_policy: missing
    networks:
      - starrs_net
  prowlarr:
    image: lscr.io/linuxserver/prowlarr:latest
    container_name: prowlarr
    environment:
      - PUID={{ gak_media_uid }}
      - PGID={{ gak_media_gid }}
      - UMASK=002
      - TZ={{ gak_media_timezone }}
    x-podman.uidmap:
        - "0:1:1"
    x-podman.gidmap:
        - "0:1:1"
        - "{{ gak_media_gid }}:{{ gak_media_gid }}:1"
    volumes:
      - .config/prowlarr/config:/config
    ports:
      - 8888:9696
    restart: unless-stopped
    pull_policy: missing
    networks:
      - starrs_net
  sonarr:
    image: ghcr.io/hotio/sonarr
    container_name: sonarr
    environment:
      - PUID={{ gak_media_uid }}
      - PGID={{ gak_media_gid }}
      - UMASK=002
      - TZ={{ gak_media_timezone }}
    x-podman.uidmap:
        - "0:1:1"
    x-podman.gidmap:
        - "0:1:1"
        - "{{ gak_media_gid }}:{{ gak_media_gid }}:1"
    volumes:
      - .config/sonarr/config:/config
      - shared_volume:/Media
    ports:
      - {{ gak_media_sonarr_port }}:8989
    restart: unless-stopped
    pull_policy: missing
    networks:
      - starrs_net
  jellyfin:
    # No PUID/PGID: this image runs as whoever starts it, so the idmaps alone
    # decide what it writes as.
    image: jellyfin/jellyfin
    container_name: jellyfin
    x-podman.uidmap:
        - "0:1:1"
    x-podman.gidmap:
        - "0:1:1"
        - "{{ gak_media_gid }}:{{ gak_media_gid }}:1"
    ports:
      - 9292:8096
    volumes:
      - .config/jellyfin/config:/config
      - .config/jellyfin/cache:/cache
      - shared_volume:/Media
    restart: unless-stopped
    pull_policy: missing
    networks:
      - starrs_net
  radarr:
    image: ghcr.io/hotio/radarr
    container_name: radarr
    environment:
      - PUID={{ gak_media_uid }}
      - PGID={{ gak_media_gid }}
      - UMASK=002
      - TZ={{ gak_media_timezone }}
    x-podman.uidmap:
        - "0:1:1"
    x-podman.gidmap:
        - "0:1:1"
        - "{{ gak_media_gid }}:{{ gak_media_gid }}:1"
    volumes:
      - .config/radarr/config:/config
      - shared_volume:/Media
    ports:
      - 8787:7878
    restart: unless-stopped
    pull_policy: missing
    networks:
      - starrs_net
  # recyclarr is a batch job, not a server: it syncs Trash Guides custom formats
  # into sonarr and exits. Hence no ports and no restart policy, and it runs as
  # the user directly rather than through the linuxserver PUID mechanism.
  #
  # https://recyclarr.dev/wiki/installation/docker/
  recyclarr:
    image: ghcr.io/recyclarr/recyclarr
    container_name: recyclarr
    user: {{ gak_media_uid }}:{{ gak_media_gid }}
    volumes:
      - .config/recyclarr:/config
    environment:
      - TZ={{ gak_media_timezone }}
  qbittorrent:
    image: lscr.io/linuxserver/qbittorrent:latest
    container_name: qbittorrent
    environment:
      - PUID={{ gak_media_uid }}
      - PGID={{ gak_media_gid }}
      - UMASK=002
      - TZ={{ gak_media_timezone }}
      # The web UI is told its own port because it is published unmapped; the
      # torrenting port is mapped and so differs inside and out.
      - WEBUI_PORT=9191
      - TORRENTING_PORT=6881
    x-podman.uidmap:
        - "0:1:1"
    x-podman.gidmap:
        - "0:1:1"
        - "{{ gak_media_gid }}:{{ gak_media_gid }}:1"
    volumes:
      - .config/qbittorrent/config:/config
      - shared_volume:/Media
    ports:
      - 9191:9191
      - 12671:6881
      - 12671:6881/udp
    restart: unless-stopped
    pull_policy: missing
    networks:
      - starrs_net

# A named volume bound to a host directory, so every service sees the media tree
# at one path regardless of where the stack directory is.
#
# `device` is relative to this file, and moving the stack does not update an
# already created volume — remove the volume first, or the containers keep
# binding the old path.
# https://stackoverflow.com/a/48264415
volumes:
  shared_volume:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: Media

networks:
  starrs_net:
    driver: bridge
    name: starrs_net
