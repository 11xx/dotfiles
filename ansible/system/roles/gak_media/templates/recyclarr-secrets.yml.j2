# Managed by Ansible (role: gak_media) — edit the role, not this file.
#
# Recyclarr resolves these implicitly: an instance named `sonarrv4` in
# recyclarr.yml takes its URL and key from `sonarrv4_base_url` and
# `sonarrv4_api_key` here, without either being named in that file. Which is why
# recyclarr.yml carries no secret and can live in the open.
#
# Keep this file to exactly the keys in use. Recyclarr fails to parse the whole
# document if it carries a key no instance claims, and reports it as a YAML
# block mapping error that points nowhere near the unused line.
sonarrv4_base_url: http://{{ gak_address }}:{{ gak_sonarr_port }}
sonarrv4_api_key: {{ sonarr_api_key }}
