# gak needs no vault: everything Ansible touches on it lives under $HOME, so no
# task escalates and there is no become password to hold. Reconfiguring the Guix
# system itself is a manual step run on the host.
ansible_user: lobo
ansible_group: lobo

# Guix System has no /usr/bin/python3 — no /usr/bin at all beyond `env` — so
# interpreter discovery finds nothing and every module fails before it runs.
# gak.yaml's first play installs this with `raw` if it is missing, which is why
# the path is the user profile: it must not depend on `guix home reconfigure`,
# a step deliberately left to a human.
ansible_python_interpreter: "/home/lobo/.guix-profile/bin/python3"
