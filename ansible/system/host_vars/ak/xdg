# group_vars/arch.yml — reads from Arch's actual env (safe since control=target)
xdg_data_home:    "{{ lookup('env', 'XDG_DATA_HOME') | default(ansible_facts['user_dir'] + '/.local/share', true) }}"
xdg_config_home:  "{{ lookup('env', 'XDG_CONFIG_HOME') | default(ansible_facts['user_dir'] + '/.config', true) }}"
xdg_cache_home:   "{{ lookup('env', 'XDG_CACHE_HOME') | default(ansible_facts['user_dir'] + '/.cache', true) }}"
xdg_bin_home:     "{{ lookup('env', 'XDG_BIN_HOME') | default(ansible_facts['user_dir'] + '/.local/bin', true) }}"
xdg_state_home:   "{{ lookup('env', 'XDG_STATE_HOME') | default(ansible_facts['user_dir'] + '/.local/state', true) }}"
xdg_runtime_dir:  "{{ lookup('env', 'XDG_RUNTIME_DIR') | default('/run/user/' + ansible_facts['user_uid'] | string, true) }}"
