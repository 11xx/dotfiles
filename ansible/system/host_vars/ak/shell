# Ak owns its interactive zsh configuration in ~/.config/shell/README.org.
# Ansible installs the checkouts loaded by its numbered rc.d fragments.
zdotdir: "{{ xdg_config_home }}/shell"
zsh_rc_dir: "{{ zdotdir }}/rc.d"
zsh_plugin_dir: /usr/share/zsh/plugins

# Sourced in list order, and the order is load-bearing. Syntax highlighting has
# to wrap the line editor after the widgets it colours already exist, and
# history-substring-search rebinds keys that highlighting has just hooked, so it
# has to come after. Everything else is order-independent; the theme goes first
# so its instant prompt runs as early as possible.
#
# Pinned to upstream tags rather than tracking a branch: a shell that breaks on
# login is painful to repair, and these plugins are feature-complete enough that
# floating buys nothing.
zsh_plugins:
  - name: powerlevel10k
    repo: https://github.com/romkatv/powerlevel10k.git
    version: v1.20.0
    entry: powerlevel10k.zsh-theme
  - name: zsh-autopair
    repo: https://github.com/hlissner/zsh-autopair.git
    version: v1.0
    entry: autopair.zsh
  - name: zsh-autosuggestions
    repo: https://github.com/zsh-users/zsh-autosuggestions.git
    version: v0.7.1
    entry: zsh-autosuggestions.zsh
  - name: zsh-syntax-highlighting
    repo: https://github.com/zsh-users/zsh-syntax-highlighting.git
    version: 0.8.0
    entry: zsh-syntax-highlighting.zsh
  - name: zsh-history-substring-search
    repo: https://github.com/zsh-users/zsh-history-substring-search.git
    version: v1.1.0
    entry: zsh-history-substring-search.zsh

# Sidecars ak initialises if present.
zsh_sidecars:
  - atuin
  - zoxide
