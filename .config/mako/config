default-timeout=5000

output=DP-1

max-history=100

width=500
height=300
max-icon-size=150

margin=10,30

border-radius=4

include=~/.config/mako/dark-mode

[mode=light]
background-color=#f6f6f680
text-color=#101010ff

border-color=#316900
border-size=3

[mode=dark]
background-color=#3a3a3a80
text-color=#f0f0f0ff
border-color=#27282c
border-size=2

[mode=dnd]
invisible=1
