#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    address: "127.0.0.1:6600",
    password: None,
    theme: Some("ansi-neron"),
    cache_dir: None,
    on_song_change: None,
    volume_step: 5,
    max_fps: 30,
    scrolloff: 0,
    wrap_navigation: false,
    enable_mouse: true,
    scroll_amount: 1,
    enable_config_hot_reload: true,
    status_update_interval_ms: 1000,
    select_current_song_on_change: false,
    ignore_leading_the: false,
    browser_song_sort: [Disc, Track, Artist, Title],
    album_art: (
        method: Auto,
        max_size_px: (width: 1200, height: 1200),
        disabled_protocols: ["http://", "https://"],
        vertical_align: Bottom,
        horizontal_align: Left,
    ),
    keybinds: (
        global: {
            ":":       CommandMode,
            ",":       VolumeDown,
            "<A-S>":   Stop,
            ".":       VolumeUp,
            "s":       ToggleSingle,
            "<Tab>":   NextTab,
            "<S-Tab>": PreviousTab,
            "<A-i>":   ShowCurrentSongInfo,
            "1":       SwitchToTab("Library"),
            "2":       SwitchToTab("Album Artists"),
            "3":       SwitchToTab("Albums"),
            "4":       SwitchToTab("Playlists"),
            "5":       SwitchToTab("Search"),
            "6":       SwitchToTab("Directories"),
            "q":       Quit,
            ">":       NextTrack,
            "<":       PreviousTrack,
            "F":       SeekForward,
            "z":       ToggleRandom,
            "r":       ToggleRepeat,
            "C":       ToggleConsume,
            "p":       TogglePause,
            "B":       SeekBack,
            "~":       ShowHelp,
            "O":       ShowOutputs,
        },
        navigation: {
            "k":       Up,
            "j":       Down,
            "h":       Left,
            "l":       Right,
            "<Up>":    Up,
            "<Down>":  Down,
            "<Left>":  Left,
            "<Right>": Right,
            "<C-k>":   PaneUp,
            "<C-j>":   PaneDown,
            "<C-h>":   PaneLeft,
            "<C-l>":   PaneRight,
            "<A-o>":   PaneRight,
            "<A-v>":   UpHalf,
            "<C-v>":   DownHalf,
            "N":       PreviousResult,
            "n":       NextResult,
            "a":       Add,
            "A":       AddAll,
            "r":       Rename,
            "g":       Top,
            "G":       Bottom,
            "<Space>": Select,
            "<CR>":    Confirm,
            "i":       FocusInput,
            "J":       MoveDown,
            "K":       MoveUp,
            "/":       EnterSearch,
            "<C-s>":   EnterSearch,
            "<C-c>":   Close,
            "<Esc>":   Close,
            "<C-g>":   Close,
            "<Del>":   Delete,
        },
        queue: {
            "<CR>":    Play,
            "o":       JumpToCurrent,
            "a":       AddToPlaylist,
            "<Del>":   Delete,
        },
    ),
    search: (
        case_sensitive: false,
        ignore_diacritics: false,
        search_button: false,
        mode: Contains,
        tags: [
            (value: "any",         label: "Any Tag"),
            (value: "artist",      label: "Artist"),
            (value: "album",       label: "Album"),
            (value: "albumartist", label: "Album Artist"),
            (value: "title",       label: "Title"),
            (value: "filename",    label: "Filename"),
            (value: "genre",       label: "Genre"),
        ],
    ),
    artists: (
        album_display_mode: NameOnly,
        album_sort_by: Date,
        album_date_tags: [OriginalDate, Date],
    ),
    tabs: [
        (
            name: "Library",
            pane: Split(
                direction: Horizontal,
                panes: [
                    (
                        size: "32",
                        pane: Split(
                            direction: Vertical,
                            panes: [
                                (
                                    size: "100%",
                                    borders: "LEFT | RIGHT | TOP",
                                    border_symbols: Rounded,
                                    border_title: [(kind: Text(" Album Artists "))],
                                    border_title_alignment: Left,
                                    pane: Pane(Browser(root_tag: "albumartist", separator: "; ")),
                                ),
                                (
                                    size: "16",
                                    borders: "ALL",
                                    border_symbols: Inherited(parent: Rounded, top_left: "├", top_right: "┤"),
                                    border_title: [(kind: Text(" Cover "))],
                                    border_title_alignment: Left,
                                    pane: Pane(AlbumArt),
                                ),
                            ],
                        ),
                    ),
                    (
                        size: "70%",
                        pane: Split(
                            direction: Vertical,
                            panes: [
                                (
                                    size: "3",
                                    borders: "ALL",
                                    border_symbols: Inherited(parent: Rounded, bottom_left: "├", bottom_right: "┤"),
                                    pane: Pane(QueueHeader()),
                                ),
                                (
                                    size: "100%",
                                    borders: "LEFT | RIGHT | BOTTOM",
                                    border_symbols: Rounded,
                                    pane: Pane(Queue),
                                ),
                            ],
                        ),
                    ),
                ],
            ),
        ),
        (
            name: "Album Artists",
            borders: "ALL",
            border_symbols: Rounded,
            pane: Pane(Browser(root_tag: "albumartist", separator: "; ")),
        ),
        (
            name: "Albums",
            borders: "ALL",
            border_symbols: Rounded,
            pane: Pane(Albums),
        ),
        (
            name: "Playlists",
            borders: "ALL",
            border_symbols: Rounded,
            pane: Pane(Playlists),
        ),
        (
            name: "Search",
            borders: "ALL",
            border_symbols: Rounded,
            pane: Pane(Search),
        ),
        (
            name: "Directories",
            borders: "ALL",
            border_symbols: Rounded,
            pane: Pane(Directories),
        ),
    ],
)
