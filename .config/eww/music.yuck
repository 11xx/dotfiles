(deflisten music-current-json-1st-instance
           :initial '{"status":{"duration":0.0,"elapsed":0.0,"elapsed_percent":0.0},"tags":{"title":"","artist":"","album_artist":"","album":""}}'
           "music-current-json --follow --player=muzaiten")

(defwidget seconds-to-length-format-hours [secs]
           (label :text { secs >= 3600 ? "${round(secs / 3600, 0)}:" : "" }))

(defwidget seconds-to-length-format-minutes [secs]
           (label :text { (secs / 60) < 10 ?
                          "0${round(secs / 60, 0)}" :
                          "${round(secs / 60, 0)}" }))

(defwidget seconds-to-length-format-seconds [secs]
           (label :text { (secs % 60) < 10 ?
                          "0${round(secs % 60, 0)}" :
                          "${round(secs % 60, 0)}" }))

(defwidget seconds-to-length [secs]
           (box
            :space-evenly false
            (seconds-to-length-format-hours :secs secs)
            (seconds-to-length-format-minutes :secs secs)
            ":"
            (seconds-to-length-format-seconds :secs secs)))

(defwidget music-current-nth-instance [curr-json ?icon]
           (box
            :space-evenly false

            (label :class "music-current-icon" :text icon)
            ;; Title
            (label :class "music-current-meta-field music-current-meta-field-title"
                   :limit-width 50
                   :text {"${curr-json.tags.title}" != "null" ? "${curr-json.tags.title}" : ""}
                   :tooltip {"${curr-json.tags.title}" != "null" ? "${curr-json.tags.title}" : ""})

            ;; Title Artist separator
            (label :class "music-current-artist-separator" :text "·")

            ;; Artist: if album_artist is empty, use Artist
            (label :class "music-current-meta-field music-current-meta-field-albumartist"
                   :limit-width 50
                   :text {curr-json.tags.album_artist != "null" ? curr-json.tags.album_artist :
                                    curr-json.tags.artist != "null" ? curr-json.tags.artist : ""}
                   :tooltip {curr-json.tags.album_artist != "null" ? curr-json.tags.album_artist :
                                       curr-json.tags.artist != "null" ? curr-json.tags.artist : ""})

            ;; Title Artist separator
            (label :class "music-current-artist-separator" :text "·")

            ;; Album
            (label :class "music-current-meta-field music-current-meta-field-album"
                   :limit-width 50
                   :text {curr-json.tags.album != "null" ? "${curr-json.tags.album}" : ""}
                   :tooltip {curr-json.tags.album != "null" ? "${curr-json.tags.album}" : ""})

            ;; Elapsed/Duration
            (box :spacing 2
                 :class "music-current-meta-field music-current-meta-field-elapsed"
                 :space-evenly false
                 (seconds-to-length :secs {curr-json.status.elapsed})
                 (label :text "/" :class "music-time-sep")
                 (seconds-to-length :secs {curr-json.status.duration})
                 (circular-progress :class "music-circular-progress"
                                    :width 20
                                    :height 20
                                    :value {curr-json.status.elapsed_percent}
                                    :thickness 4
                                    :start-at 70
                                    :valign "center"
                                    :tooltip "${curr-json.status.elapsed_percent}%"))))

(defwidget music-current-1st-wrap []
           (music-current-nth-instance :curr-json {music-current-json-1st-instance}))

(defvar music-expand-bool true)
(defwidget music-current []
           (box :class "music-current-box"
                :space-evenly false
                :orientation "h"
                :valign "center"
                (music-current-1st-wrap)))
