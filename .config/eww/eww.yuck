(defwindow mainbar
           :monitor "DELL S2721DGF"
           :geometry (geometry :x "0px"
                               :y "0px"
                               :width "100%"
                               :height "26px"
                               :anchor "top center")
           :stacking "fg" ; foreground is still below fullscreen
           :reserve (struts :distance "30px" :side "top")
           ;; :windowtype "dock" ; x11
           ;; :wm-ignore false ; x11
           :exclusive true ; wayland
           :namespace "bar" ; wayland
           :class "mainbar"
           (bar-all-modules))

(defwindow mainbar2
           :monitor "DELL P2418D"
           :geometry (geometry :x "0px"
                               :y "0px"
                               :width "100%"
                               :height "26px"
                               :anchor "top center")
           :stacking "fg" ; foreground is still below fullscreen
           :reserve (struts :distance "30px" :side "top")
           :exclusive true ; wayland
           :namespace "bar" ; wayland

           ;; for some reason when two defwindows use the same class it either
           ;; appends a number to it or requires manual disambiguation.
           :class "mainbar2"
           (box :space-evenly true
                (box :orientation "h"
                     :space-evenly false
                     (label :text "${time}" :class "time-label"))
                (box :orientation "h"
                     :space-evenly false
                     :halign "end"
                     (window-title-second-monitor)
                     (sep)
                     (workspaces)
                     (sep))))

(defwidget bar-all-modules []
           (box :space-evenly true
                :class "bar-all-modules"
                :orientation "h"
                (left-modules)
                ;; (center-modules)
                (right-modules)))

(defwidget sep []
           (label :class "separator" :text "|"))

(defwidget left-modules []
           (box :orientation "h"
                :space-evenly false
                :halign "start"
                :class "left-modules"
                (workspaces)
                (sep)
                (window-title)))

(defwidget center-modules []
           (box :orientation "h"
                :space-evenly false
                ;; :halign "center"
                :halign "center"
                :class "center-modules"))

(defwidget right-modules []
           (box :orientation "h"
                :space-evenly false
                :halign "end"
                :class "right-modules"
                (mpd-current :nth 0)
                (sep)
                (systray :orientation "h" :spacing 10 :icon-size 24)
                (sep)
                (label :text "${time}" :class "time-label")))

(defvar time-visible false)   ; for :run-while property of below variable
                              ; when this turns true, the polling starts and
                              ; var gets updated with given interval

(defpoll time :interval "5s"
              :initial "Loading date..."  ; optional, defaults to poll at startup
              :run-while time-visible   ; optional, defaults to 'true'
              "date +'%Y/%m/%d (%H:%M)'")

(deflisten workspaces-listen :initial "[]" "hypr-get-workspaces")
(deflisten current-workspace :initial '{"focused_monitor":{"active_workspace":"1"},"unfocused":{"active_workspace":"2"}}' "hypr-get-current-monitor-workspace")
(defwidget workspaces []
  (eventbox
   :class "workspaces-widget-eventbox"

   (box
    :space-evenly true
    (label :text "${workspaces-listen}${current-workspace}"
           :visible false)
    (for workspace in workspaces-listen
         (eventbox
          (box :class "workspace-entry ${workspace.id == current-workspace.focused_monitor.active_workspace ? "current" : ""} \
                       ${workspace.windows > 0 ? "occupied" : "empty"} \
                       ${workspace.id == current-workspace.unfocused_monitor.active_workspace ? "active-unfocused" : ""}"
               (label :text "${workspace.id}")))))))

(deflisten window-listen :initial "..." "hypr-get-window-title")
(deflisten window-listen-second-monitor :initial "..." "hypr-get-window-title-second-monitor DP-2")
(defwidget window-title []
  (box
   (label :text "${window-listen}"
          :limit-width 50
          :class "window-title-label"
          ;; :truncate-left true
          )))

(defwidget window-title-second-monitor []
  (box
   (label :text "${window-listen-second-monitor}"
          :limit-width 70
          :class "window-title-label"
          ;; :truncate-left true
          )))

(include "mpd.yuck")
