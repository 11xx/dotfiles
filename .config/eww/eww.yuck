;; The bars.
;;
;; Both bars are one widget set parameterised by which monitor they describe,
;; not two near-copies: one window title, one monitor indicator asking whether
;; the focused monitor is its own, one workspace entry that receives the two
;; workspace ids it needs to compare against rather than deriving them once per
;; class. The clusters are spaced rather than ruled, so no separator widget
;; exists.
;;
;; Widgets that belong to another project are included from its checkout rather
;; than copied, so behaviour and presentation stay with the thing they describe
;; and this file only places them and supplies the palette. The includes at the
;; bottom of this file name every one; README.org lists them with what feeds
;; them.

(deflisten bar
           :initial '{"monitors":{"DP-1":{"focused":true,"workspace":"0","title":""},"DP-2":{"focused":false,"workspace":"0","title":""}},"workspaces":[]}'
           "hypr-bar-feed")

(defwindow mainbar [monitor ?height-px]
           :monitor monitor
           :geometry (geometry :x "0px"
                               :y "0px"
                               :width "100%"
                               :height {height-px ?: "26px"}
                               :anchor "top center")
           :stacking "fg" ; foreground is still below fullscreen
           :reserve (struts :distance {height-px ?: "26px"} :side "top")
           :exclusive true ; wayland
           :namespace "bar" ; wayland
           (bar-all-modules))

(defwindow mainbar2 [monitor ?height-px]
           :monitor monitor
           :geometry (geometry :x "0px"
                               :y "0px"
                               :width "100%"
                               :height {height-px ?: "26px"}
                               :anchor "top center")
           :stacking "fg" ; foreground is still below fullscreen
           :reserve (struts :distance {height-px ?: "26px"} :side "top")
           :exclusive true ; wayland
           :namespace "bar" ; wayland

           (bar2-all-modules))

(defwidget bar-all-modules []
           (box :space-evenly true
                :class "bar-all-modules"
                :orientation "h"
                (bar-left-modules)
                (bar-middle-modules)
                (bar-right-modules)))

(defwidget bar2-all-modules []
           (box :space-evenly true
                :class "bar-all-modules"
                :orientation "h"
                (bar2-left-modules)
                (bar2-right-modules)))

(defwidget bar-left-modules []
           (box :orientation "h"
                :space-evenly false
                :halign "start"
                :class "bar-left-modules"
                :spacing 14
                (active-monitor-indicator :focused {bar.monitors.DP-1.focused})
                (workspaces-bar :here {bar.monitors.DP-1.workspace}
                                :elsewhere {bar.monitors.DP-2.workspace}
                                :monitor "DP-1")
                (window-title :text {bar.monitors.DP-1.title} :limit 50)))

(defwidget bar-middle-modules []
           (box :orientation "h"
                :space-evenly false
                :halign "center"
                :class "bar-middle-modules"
                (harness-status-codex)
                (harness-status-claude)
                (harness-status-pi)
                ;; On this bar only: cu drives one desktop, not one monitor, so a
                ;; second copy would poll the same state twice.
                (cu-indicator)))

(defwidget bar-right-modules []
           (box :orientation "h"
                :space-evenly false
                :halign "end"
                :class "bar-right-modules"
                ;; Tray icons sized to the text they sit beside, and spacing
                ;; instead of rules: three unlike things in a row read as three
                ;; things without being fenced off from each other.
                :spacing 14
                (codex-reset-indicator :icon "../../code/tibo-reset-monitor/eww/assets/codex-resets.png")
                (harness-usage :assets "../../code/harness-status/eww/assets")
                (systray :orientation "h" :spacing 9 :icon-size 17)
                (swaync_icon)
                (clock :edge "right")))

(defwidget bar2-left-modules []
           (box :orientation "h"
                :space-evenly false
                :halign "start"
                :spacing 14
                (clock :edge "left")
                (gsr-indicator)
                (music-current)))

(defwidget bar2-right-modules []
           (box :orientation "h"
                :space-evenly false
                :halign "end"
                :spacing 14
                (window-title :text {bar.monitors.DP-2.title} :limit 70)
                (workspaces-bar :here {bar.monitors.DP-2.workspace}
                                :elsewhere {bar.monitors.DP-1.workspace}
                                :monitor "DP-2")
                (active-monitor-indicator :focused {bar.monitors.DP-2.focused})))

(defwidget active-monitor-indicator [focused]
           (box :class {focused ? "focused-monitor" : "unfocused-monitor"}))

;; Polled because there is no event to listen to: the state is derived from
;; whether a recorder process exists, and a process starting is not something
;; the compositor or the recorder announces. `gsr status` is the single source
;; of that answer, so the indicator is right even when the recording was started
;; from a terminal or ended without telling anyone.
(defpoll gsr-state :interval "2s"
                   :initial "idle"
                   "gsr status")

;; Hidden entirely while nothing is recording -- an always-present idle icon
;; would be noise on a bar this dense. Every state `gsr` can print is named, and
;; an unknown one is shown verbatim, so a state added later appears as itself
;; instead of silently reading as a buffer.
(defwidget gsr-indicator []
           (box :visible {gsr-state != "idle"}
                :class "gsr-indicator gsr-indicator--${gsr-state}"
                (label :text {gsr-state == "recording" ? "● REC"
                              : gsr-state == "buffer" ? "● BUF"
                              : "● ${gsr-state}"})))

;; `2026-08-09 Sun 12:41`: ISO order, so it sorts the way dates are written
;; everywhere else here, with the weekday appended for the question a date alone
;; does not answer. One `date` call emits both fields as JSON, which lets the
;; stylesheet hold the reference part and the glanced-at part apart without a
;; second process. `edge` names the screen edge the clock sits against on its
;; own bar, since the padding belongs on the side facing that edge.
(defpoll clock :interval "20s"
               :initial '{"date":"--------- ---","time":"--:--"}'
               `date +'{"date":"%Y-%m-%d %a","time":"%H:%M"}'`)

(defwidget clock [edge]
           (box :class "clock clock--${edge}"
                :space-evenly false
                :spacing 7
                (label :class "clock__date" :text {clock.date})
                (label :class "clock__time" :text {clock.time})))

(defwidget workspace-entry [id windows here elsewhere monitor]
  (eventbox
    ;; Its own monitor is focused first: the bar that was clicked names the
    ;; monitor the workspace should appear on, which is not necessarily the one
    ;; that had focus. Dispatchers go through the config's Lua API, since a raw
    ;; dispatcher string is intercepted by it and does nothing.
    :onclick "hyprctl dispatch \"hl.dsp.focus({ monitor = '${monitor}' })\" && hyprctl dispatch \"hl.dsp.focus({ workspace = ${id}, on_current_monitor = true })\""
    (box :class "workspace-entry ${id == here ? 'current' : ''} ${windows > 0 ? 'occupied' : 'empty'} ${id == elsewhere ? 'active-unfocused' : ''}"
         (label :text id))))

(defwidget workspaces-bar [here elsewhere monitor]
  (eventbox
    :class "workspaces-widget-eventbox"
    (box
      :space-evenly true
      (for workspace in {bar.workspaces}
        (workspace-entry
          :id {workspace.id}
          :windows {workspace.windows}
          :here here
          :elsewhere elsewhere
          :monitor monitor)))))

(defwidget window-title [text limit]
           (label :class "window-title-label"
                  :limit-width limit
                  :text text
                  :tooltip text))

(include "music.yuck")
(include "../../code/harness-status/eww/harness-status.yuck")
(include "../../code/tibo-reset-monitor/eww/codex-reset.yuck")
(include "../../code/ai-agent-computer-use/eww/cu.yuck")
(include "swaync.yuck")
