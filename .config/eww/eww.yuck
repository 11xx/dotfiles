(deflisten current-monitor :initial '{"focused":true}' "hypr-active-monitor DP-1")

(defwindow mainbar
           :monitor "DELL S2721DGF"
           :geometry (geometry :x "0px"
                               :y "0px"
                               :width "100%"
                               :height "26px"
                               :anchor "top center")
           :stacking "fg" ; foreground is still below fullscreen
           :reserve (struts :distance "30px" :side "top")
           :exclusive true ; wayland
           :namespace "bar" ; wayland
           (bar-mainbar-all-modules))

(defwindow mainbar2
           :monitor "DELL P2418D"
           :geometry (geometry :x "0px"
                               :y "0px"
                               :width "100%"
                               :height "26px"
                               :anchor "top center")
           :stacking "fg" ; foreground is still below fullscreen
           :reserve (struts :distance "30px" :side "top")
           :exclusive true ; wayland
           :namespace "bar" ; wayland

           (bar-mainbar2-all-modules))

(defwidget bar-mainbar-all-modules []
           (box :space-evenly true
                :class "bar-all-modules"
                :orientation "h"
                (left-modules)
                ;; (center-modules)
                (right-modules)))

(defwidget bar-mainbar2-all-modules []
           (box :space-evenly true
                ;; left
                (box :orientation "h"
                     :space-evenly false
                     :halign "start"
                     (label :text "${time}" :class "time-label")
                     (sep)
                     (mpd-current :nth 0))
                ;; right
                (box :orientation "h"
                     :space-evenly false
                     :halign "end"
                     (window-title-second-monitor)
                     (sep)
                     (workspaces-bar :monitor-name "DP-2")
                     (sep)
                     (active-monitor2-indicator)
                     )))

(defwidget active-monitor-indicator []
           (box :class "${current-monitor.focused == true ? 'focused-monitor' : 'unfocused-monitor' }"))
(defwidget active-monitor2-indicator []
           (box :class "${current-monitor.focused == false ? 'focused-monitor' : 'unfocused-monitor' }"))

(defwidget sep []
           (label :class "separator" :text "|"))

(defwidget left-modules []
           (box :orientation "h"
                :space-evenly false
                :halign "start"
                :class "left-modules"
                (active-monitor-indicator)
                (workspaces-bar :monitor-name "DP-1")
                (sep)
                (window-title)))

(defwidget center-modules []
           (box :orientation "h"
                :space-evenly false
                ;; :halign "center"
                :halign "center"
                :class "center-modules"))

(defwidget right-modules []
           (box :orientation "h"
                :space-evenly false
                :halign "end"
                :class "right-modules"
                (systray :orientation "h" :spacing 10 :icon-size 24)
                (sep)
                (swaync_icon)
                (sep)
                (label :text "${time}" :class "time-label")))

(defvar time-visible false)   ; for :run-while property of below variable
                              ; when this turns true, the polling starts and
                              ; var gets updated with given interval

(defpoll time :interval "5s"
              :initial "Loading date..."  ; optional, defaults to poll at startup
              :run-while time-visible   ; optional, defaults to 'true'
              "date +'%Y/%m/%d (%H:%M)'")

(deflisten workspaces-listen :initial "[]" "hypr-get-workspaces")
(deflisten current-workspace :initial '{"focused_monitor":{"active_workspace":"1","active_workspace_id":1,"name":"DP-1"},"unfocused_monitor":{"active_workspace":"10","active_workspace_id":10,"name":"DP-2"}}'
           "hypr-get-current-monitor-workspace")

(defwidget workspaces-bar [monitor-name]
  (eventbox
    :class "workspaces-widget-eventbox"
    (box
      :space-evenly true
      ;; trigger deflisten to update the whole widget
      (label :text "${current-workspace}"
             :visible false)
      (for workspace in workspaces-listen
        (eventbox
          (box
            :class "workspace-entry ${
              workspace.id == (
                current-workspace.focused_monitor.name == monitor-name
                  ? current-workspace.focused_monitor.active_workspace
                  : current-workspace.unfocused_monitor.active_workspace
              ) ? "current" : ""
            } ${
              workspace.windows > 0 ? "occupied" : "empty"
            } ${
              workspace.id == (
                current-workspace.focused_monitor.name == monitor-name
                  ? current-workspace.unfocused_monitor.active_workspace
                  : current-workspace.focused_monitor.active_workspace
              ) ? "active-unfocused" : ""
            }"
            (label :text "${workspace.id}")))))))

(deflisten window-listen :initial "..." "hypr-get-window-title")
(deflisten window-listen-second-monitor :initial "..." "hypr-get-window-title-second-monitor DP-2")
(defwidget window-title []
  (box
   (label :text "${window-listen}"
          :limit-width 50
          :class "window-title-label"
          ;; :truncate-left true
          )))

(defwidget window-title-second-monitor []
  (box
   (label :text "${window-listen-second-monitor}"
          :limit-width 70
          :class "window-title-label"
          ;; :truncate-left true
          )))

(include "mpd.yuck")
(include "swaync.yuck")
