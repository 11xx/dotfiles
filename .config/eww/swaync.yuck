;; Nothing else on this bar draws a container, so neither does this: a bell, a
;; count when there is one, and colour for the state. `alt` distinguishes six
;; states, but only one of them changes what a notification means to the user --
;; whether do-not-disturb is swallowing them -- so only that splits the glyph.
;; The rest reach the stylesheet as a class.

(deflisten swaync_data :initial '{"text": "0", "alt": "none", "tooltip": "", "class": "none"}'
           "swaync-client -swb")

(defwidget swaync_icon []
           (eventbox
            :onclick "swaync-client -t -sw"
            :onrightclick "swaync-client -d -sw"
            :onmiddleclick "swaync-client -C -sw"
            :tooltip {swaync_data.tooltip != "" ? swaync_data.tooltip : "${swaync_data.text} notifications"}
            :class "swaync swaync--${swaync_data.alt}"
            (box
             :space-evenly false
             :spacing 5
             (label :class "swaync__bell"
                    :text {matches(swaync_data.alt, "dnd") ? "󰂛" : "󰂚"})
             (label :class "swaync__count"
                    :visible {swaync_data.text != "0"}
                    :text {swaync_data.text}))))
