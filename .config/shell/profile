#!/usr/bin/echo 'This is a source only file.'
source "$XDG_CONFIG_HOME/shell/functions"

export GIT_EDITOR=emacsclient-code
export ALTERNATE_EDITOR=emacs
export EDITOR=emacsclient-def
export VISUAL=emacsclient-def
export TERMINAL=alacritty
export BROWSER=zen-browser
export VIDEO=mpv
export IMAGE=qimgv
export OPENER=launch
export PAGER=bat
export WM=start-hyprland
export READER=zatura

if is_systemd_system; then
    set -a
    for env_file in "${XDG_CONFIG_HOME}"/environment.d/*.conf; do
        [ -f "${env_file}" ] && source "${env_file}"
    done
    set +a
fi
