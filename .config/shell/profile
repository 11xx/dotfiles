export RUSTUP_HOME=${XDG_DATA_HOME}/rustup
alias wget="wget --hsts-file=${XDG_DATA_HOME}/wget-hsts"
export CALCHISTFILE=${XDG_CACHE_HOME}/calc_history
export RANDFILE=${XDG_CACHE_HOME}/rnd
export SQLITE_HISTORY=${XDG_CACHE_HOME}/sqlite_history

#export READER="zatura"
export GIT_EDITOR='emacs-minimal -t git-floatWMRULE'
export ALTERNATE_EDITOR='emacs-minimal -nw'
export EDITOR="emacs-launcher -nw -m"
export VISUAL="emacs-launcher -m"
export TERMINAL=alacritty
export BROWSER=firefox
export VIDEO=mpv
export IMAGE=qimgv
export OPENER=launch
export PAGER=bat
export WM=Hyprland

ps -p 1 -o comm= | grep -q systemd &&
    [ "$(/usr/lib/systemd/user-environment-generators/30-systemd-environment-d-generator | wc -l)" != 0 ] &&
    export $(run-parts /usr/lib/systemd/user-environment-generators/ | xargs)

# check for duplicates in the PATH again
PATH="$(perl -e 'print join(":", grep { not $seen{$_}++ } split(/:/, $ENV{PATH}))')"

export MOZ_DISABLE_RDD_SANDBOX=1
export NVD_BACKEND=direct

export LSP_USE_PLISTS=true
