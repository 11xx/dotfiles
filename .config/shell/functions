#!/usr/bin/echo 'This is a source only file.'
append_path () {
    case ":$PATH:" in
        *:"$1":*)
        ;;
        *)
            PATH="${PATH:+$PATH:}$1"
            PATH="${PATH#:}"
            PATH="${PATH%:}"
    esac
}

prepend_path () {
    # Prioritize $1 over system PATH directories
    case ":$PATH:" in
        *:"$1":*)
        ;;
        *)
            PATH="$1:${PATH:+$PATH:}"
            PATH="${PATH#:}"
            PATH="${PATH%:}"
    esac
}

is_systemd_system() {
    ps -p 1 -o comm= | grep -q systemd
}
