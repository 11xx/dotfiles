#!/usr/bin/echo 'This is a source only file.'
alias pac='sudo /usr/bin/pacman -S'
alias pacss='/usr/bin/pacman -Ss'
alias pacssq='/usr/bin/pacman -Ssq'
alias pacsyu='sudo /usr/bin/pacman -Syu'
alias paruss='paru -Ss'
alias pacrcsn='sudo /usr/bin/pacman -Rcsn'
alias pacrsn='sudo /usr/bin/pacman -Rsn'
alias pacrcn='sudo /usr/bin/pacman -Rcn'
alias update='pacsyu; paru'
alias pacqs='/usr/bin/pacman -Qs'
alias pacqi='/usr/bin/pacman -Qi'
alias pacsi='/usr/bin/pacman -Si'
alias parusi='paru -Si'
alias pacqo='/usr/bin/pacman -Qo'
alias pacqi='/usr/bin/pacman -Qi'
alias pacf='/usr/bin/pacman -F'
alias pacfy='/usr/bin/pacman -Fy'

alias sd="systemctl"
alias sdu="systemctl --user"
alias suspend='systemctl suspend'
alias cdsd='cd /etc/systemd/system'
alias cdsdu='cd "$XDG_CONFIG_HOME"/systemd/user'

# alias sudo='doas'
alias doas=sudo

if command -v cpg > /dev/null && command -v mvg > /dev/null; then
    alias cp="cpg -vi --progress-bar"
    alias mv="mvg -vi --progress-bar"
else
    alias cp="cp -vi"
    alias mv="mv -vi"
fi

alias e="$EDITOR"
alias re="sudo $EDITOR"
alias a="aria2c"
alias f="fzf"
alias c="bat"
alias b="bat"

alias l='eza -lag --color=auto --group-directories-first --time-style long-iso'
alias lt='l -T'
# alias cd-file-manager-actions="cd ~/.local/share/file-manager/actions"
alias cdc='cd "$XDG_CONFIG_HOME"'
alias cds='cd "$XDG_DATA_HOME"'
alias cdcc='cd "$XDG_CACHE_HOME"'
alias cdst='cd "$XDG_STATE_HOME"'
alias cdconf='cd "$XDG_CONFIG_HOME"'
alias cdshare='cd "$XDG_DATA_HOME"'
alias cdcache='cd "$XDG_CACHE_HOME"'
alias cdstate='cd "$XDG_STATE_HOME"'

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias ......='cd ../../../../..'
