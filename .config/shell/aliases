alias mkdir='mkdir -pv'

alias dot='git --git-dir="$HOME/.local/dotfiles.git" --work-tree="$HOME"'

alias alarm='ssh -p 1111 alarm@alarm'

alias pc='patool create'
alias pe='patool extract'
alias px='patool extract'
alias pl='patool list'
alias xs='xtodir'

alias rgboff='sudo openrgb --device 0 -m off; sudo openrgb --device 1 -m off;'

