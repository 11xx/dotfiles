[options]
background = 1b1b1c
scaling_mode = full
upscaling_method = linear
loop_input = true

overlay = true
overlay_position_bottom = true
overlay_font = monospace:11
overlay_background_alpha = c3
overlay_text = [$imv_current_index/$imv_file_count]  $imv_current_file  |  ${imv_width}x${imv_height}  |  $imv_scale%  |  $imv_scaling_mode

suppress_default_binds = true

[binds]
q = quit
<Escape> = quit

j = next
k = prev
n = next
p = prev
<Right> = next
<Left> = prev
gg = goto 1
<Shift+G> = goto -1

<Ctrl+h> = pan 50 0
<Ctrl+l> = pan -50 0
<Ctrl+k> = pan 0 50
<Ctrl+j> = pan 0 -50
<Ctrl+b> = pan 50 0
<Ctrl+f> = pan -50 0
<Ctrl+p> = pan 0 50
<Ctrl+n> = pan 0 -50

<Shift+K> = zoom 1
<Shift+J> = zoom -1
<Shift+N> = zoom 1
<Shift+P> = zoom -1
<Up> = zoom 1
<Down> = zoom -1

<Return> = scaling next
s = scaling next
<Shift+S> = upscaling next
f = fullscreen
d = overlay
c = center
a = zoom actual
<Ctrl+r> = reset
r = rotate by 90
<Shift+R> = rotate by -90

<period> = next_frame
<space> = toggle_playing
x = close
y = exec wl-copy < "$imv_current_file"
