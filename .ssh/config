Host alarm
     User alarm
     Port 1111
     Hostname alarm # resolved by /etc/hosts
     IdentityFile ~/.ssh/local2alarm

Host *
     ServerAliveInterval 5
     AddKeysToAgent yes # man ssh_config | sed -n '/AddKeysToAgent/,/^$/p'

Host aur.archlinux.org
     IdentityFile ~/.ssh/aur
     User aur

Host codeberg.org
     IdentityFile ~/.ssh/git-upstream-winr58
     IdentityFile ~/.ssh/git-dotfiles

Host github.com
     IdentityFile ~/.ssh/github
     IdentityFile ~/.ssh/git-upstream-push

