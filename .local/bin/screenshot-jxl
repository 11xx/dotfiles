#!/usr/bin/env bash
set -Eeuo pipefail

app_name="Screenshot"

mode="fullscreen"
include_cursor=0

copy_mode="path"
notify_enabled=1
verbose=0

jxl_effort=9
jxl_distance=0
output_dir=""

usage() {
    cat <<'EOF'
Usage:
  screenshot-jxl [OPTIONS]

Capture mode:
  -s, --select               Capture a selected region with slurp
  -w, --window               Click a window to capture it (Hyprland)
  -f, --fullscreen           Capture fullscreen (default)
  -c, --cursor               Include cursor in the capture

Output:
      --lossy                Lossy JXL encode (--distance 2.0, smaller files)
      --lossless             Mathematically lossless JXL (default)
      --effort N             Set JXL effort 1..10 (default: 9)
      --output-dir DIR       Directory for screenshots
      --screenshots-dir DIR  Alias for --output-dir

Clipboard:
      --copy path            Copy final .jxl path to clipboard (default)
      --copy image           Copy PNG image data to clipboard
      --copy none            Do not touch clipboard

Notifications:
      --no-notify            Disable desktop notifications

Debugging:
  -v, --verbose              Enable shell tracing

Help:
  -h, --help                 Show this help text

Behavior:
  - Captures once using grim
  - Creates a small PNG notification thumbnail immediately
  - Sends the screenshot notification before JXL encoding
  - Saves a JPEG XL file (lossless by default, lossy with --lossy)
EOF
}

notify_error() {
    [[ "$notify_enabled" -eq 1 ]] || return 0
    command -v notify-send >/dev/null 2>&1 || return 0

    notify-send --urgency=low --app-name="$app_name" \
        "Screenshot failed" \
        "$1"
}

die() {
    notify_error "$1" || true
    printf 'screenshot-jxl: %s\n' "$1" >&2
    exit 1
}

need() {
    command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"
}

check_effort() {
    case "$1" in
        [1-9]|10) ;;
        *) die "--effort must be an integer from 1 to 10" ;;
    esac
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -s|--select)
            mode="region"
            shift
            ;;
        -w|--window)
            mode="window"
            shift
            ;;
        -f|--fullscreen)
            mode="fullscreen"
            shift
            ;;
        -c|--cursor)
            include_cursor=1
            shift
            ;;
        --effort)
            [[ $# -ge 2 ]] || die "--effort requires a value"
            jxl_effort="$2"
            shift 2
            ;;
        --lossy)
            jxl_distance=2.0
            shift
            ;;
        --lossless)
            jxl_distance=0
            shift
            ;;
        --output-dir|--screenshots-dir)
            [[ $# -ge 2 ]] || die "$1 requires a directory"
            output_dir="$2"
            shift 2
            ;;
        --copy)
            [[ $# -ge 2 ]] || die "--copy requires: path, image, or none"
            case "$2" in
                path|image|none)
                    copy_mode="$2"
                    ;;
                *)
                    die "invalid --copy mode: $2"
                    ;;
            esac
            shift 2
            ;;
        --no-notify)
            notify_enabled=0
            shift
            ;;
        -v|--verbose)
            verbose=1
            set -x
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -* )
            die "unknown option: $1"
            ;;
        *)
            die "unexpected positional argument: $1"
            ;;
    esac
done

check_effort "$jxl_effort"

need grim
need cjxl
need magick

if [[ "$mode" = "region" ]]; then
    need slurp
fi

if [[ "$mode" = "window" ]]; then
    need slurp
    need jq
    need hyprctl
fi

if [[ "$copy_mode" != "none" ]]; then
    need wl-copy
fi

if [[ "$notify_enabled" -eq 1 ]]; then
    need notify-send
fi

get_pictures_dir() {
    if command -v xdg-user-dir >/dev/null 2>&1; then
        xdg-user-dir PICTURES 2>/dev/null || printf '%s/Pictures\n' "$HOME"
    else
        printf '%s/Pictures\n' "$HOME"
    fi
}

pictures_dir="$(get_pictures_dir)"

if [[ -z "$output_dir" ]]; then
    output_dir="$pictures_dir/screenshots"
fi

mkdir -p "$output_dir"

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/screenshot-jxl"
mkdir -p "$cache_dir"

timestamp="$(date +'%Y%m%d-%H%M%S')"
base_name="${timestamp}-screenshot"

output_file="$output_dir/${base_name}.jxl"
thumb_file="$cache_dir/${base_name}-thumb.png"

tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/screenshot-jxl.XXXXXXXX")"
trap 'rm -rf "$tmpdir"' EXIT

tmp_ppm="$tmpdir/capture.ppm"

grim_args=(-t ppm)

if [[ "$include_cursor" -eq 1 ]]; then
    grim_args+=(-c)
fi

if [[ "$mode" = "region" ]]; then
    geometry="$(slurp || true)"
    [[ -n "${geometry:-}" ]] || die "selection cancelled"
    grim_args+=(-g "$geometry")
elif [[ "$mode" = "window" ]]; then
    visible_ws="$(hyprctl -j monitors \
        | jq -c '[.[] | .activeWorkspace.id, .specialWorkspace.id]')" \
        || die "could not query Hyprland monitors"

    window_boxes="$(hyprctl -j clients \
        | jq -r --argjson vis "$visible_ws" '
            .[]
            | select(.mapped and (.hidden | not))
            | select(.workspace.id as $id | ($vis | index($id)) != null)
            | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1]) \(.class)"')" \
        || die "could not query Hyprland windows"

    [[ -n "$window_boxes" ]] || die "no on-screen windows to select"

    geometry="$(printf '%s\n' "$window_boxes" | slurp -r || true)"
    [[ -n "${geometry:-}" ]] || die "selection cancelled"
    grim_args+=(-g "$geometry")
fi

grim "${grim_args[@]}" "$tmp_ppm" || die "grim failed"

[[ -s "$tmp_ppm" ]] || die "capture was not created"

make_thumbnail() {
    magick "$tmp_ppm" \
        -thumbnail '300x300>' \
        -strip \
        -define png:compression-level=0 \
        "$thumb_file" \
        >/dev/null 2>&1 || true
}

make_thumbnail

notify_captured() {
    [[ "$notify_enabled" -eq 1 ]] || return 0

    local title
    case "$mode" in
        region) title="Region screenshot captured" ;;
        window) title="Window screenshot captured" ;;
        *)      title="Fullscreen screenshot captured" ;;
    esac

    local kind
    if [[ "$jxl_distance" = "0" ]]; then
        kind="lossless"
    else
        kind="lossy"
    fi

    local body
    body="Encoding $kind JPEG XL: $output_file"

    case "$copy_mode" in
        path)  body+=$'\nClipboard: copying output path' ;;
        image) body+=$'\nClipboard: preparing PNG image data' ;;
        none)  body+=$'\nClipboard: unchanged' ;;
    esac

    if [[ -f "$thumb_file" ]]; then
        notify-send --urgency=normal --app-name="$app_name" \
            --icon="$thumb_file" \
            "$title" \
            "$body"
    else
        notify-send --urgency=normal --app-name="$app_name" \
            "$title" \
            "$body"
    fi
}

notify_captured

case "$copy_mode" in
    path)
        printf '%s' "$output_file" | wl-copy
        ;;
    image)
        magick "$tmp_ppm" png:- | wl-copy --type image/png || \
            die "failed to copy PNG image to clipboard"
        ;;
    none)
        ;;
esac

encode_jxl() {
    cjxl "$tmp_ppm" "$output_file" \
        --distance "$jxl_distance" \
        --effort "$jxl_effort" \
        >/dev/null || die "cjxl encode failed"

    [[ -s "$output_file" ]] || die "JXL output was not created"
}

encode_jxl

find "$cache_dir" -type f -name '*-thumb.png' -mtime +7 -delete \
    >/dev/null 2>&1 || true

printf 'OUTPUT=%s\n' "$output_file"
printf 'EFFORT=%s\n' "$jxl_effort"
printf 'DISTANCE=%s\n' "$jxl_distance"
