#!/usr/bin/env python3
import datetime as dt
import ipaddress
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import socket
import subprocess
import sys
import urllib.error
import urllib.request
from urllib.parse import parse_qs, urlsplit


MANAGER = "/home/aiagent/.local/bin/aiagent"
BASE_DIR = "/home/node/.t3/userdata"


class OperatorError(Exception):
    pass


def usage():
    print("usage: gak-aiagent {status|providers|shell|restart|update [--verbose]|provider-reseed [--verbose]|t3 open|t3 pair [label]|help}")


def ssh_args(interactive=False):
    target = os.environ.get("GAK_AIAGENT_SSH_TARGET", "aiagent@gak")
    identity = os.path.expanduser(os.environ.get("GAK_AIAGENT_SSH_KEY", "~/.ssh/gak_aiagent"))
    if not target or target.startswith("-") or any(c.isspace() for c in target):
        raise OperatorError("invalid GAK_AIAGENT_SSH_TARGET")
    if not Path(identity).is_file():
        raise OperatorError(f"SSH identity is missing: {identity}")
    if shutil.which("ssh") is None:
        raise OperatorError("ssh is required")
    return ["ssh", "-tt" if interactive else "-T", "-i", identity,
            "-o", "IdentitiesOnly=yes", "-o", "BatchMode=yes",
            "-o", "ConnectTimeout=10", target]


def remote_argv(*args):
    return shlex.join(args)


def remote_capture(*args):
    command = ssh_args() + [remote_argv(*args)]
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=25)
    except subprocess.TimeoutExpired:
        raise OperatorError("Gak did not respond within 25 seconds") from None
    if result.returncode:
        if result.returncode == 255:
            raise OperatorError("SSH connection to Gak failed; check target, key and network")
        raise OperatorError("Gak command failed; check SSH access and agent health")
    return result.stdout


def normalize_https_origin(value):
    invalid = OperatorError("GAK_AIAGENT_T3_URL must be a valid HTTPS origin")
    if not value or any(c.isspace() or ord(c) < 33 or ord(c) == 127 for c in value):
        raise invalid
    try:
        parsed = urlsplit(value)
        host = parsed.hostname
        port = parsed.port
        if (parsed.scheme != "https" or not host or parsed.username is not None
                or parsed.password is not None or parsed.path not in ("", "/")
                or "?" in value or "#" in value or parsed.netloc.endswith(":")):
            raise ValueError
        if parsed.netloc.startswith("["):
            _, closing, tail = parsed.netloc.partition("]")
            if not closing or (tail and not re.fullmatch(r":[0-9]+", tail)):
                raise ValueError
            if "%" in host:
                raise ValueError
            address = ipaddress.IPv6Address(host)
            if address.ipv4_mapped is not None:
                mapped = int(address.ipv4_mapped)
                authority = f"[::ffff:{mapped >> 16:x}:{mapped & 0xffff:x}]"
            else:
                authority = f"[{address.compressed}]"
        else:
            if ":" in host:
                raise ValueError
            try:
                authority = str(ipaddress.IPv4Address(host))
            except ipaddress.AddressValueError:
                labels = host.removesuffix(".").split(".")
                if (not host.isascii() or len(host) > 254 or not labels
                        or any(not re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?", label)
                               for label in labels)
                        or labels[-1].isdigit() or labels[-1].startswith("0x")):
                    raise ValueError
                authority = host
        if port is not None:
            if port == 0:
                raise ValueError
            if port != 443:
                authority += f":{port}"
        return "https://" + authority
    except ValueError:
        raise invalid from None


def origin():
    explicit = os.environ.get("GAK_AIAGENT_T3_URL")
    if explicit is not None:
        value = explicit
    else:
        service = os.environ.get("GAK_AIAGENT_T3_SERVICE", "t3")
        if not re.fullmatch(r"[a-z][a-z0-9-]*", service):
            raise OperatorError("invalid GAK_AIAGENT_T3_SERVICE")
        try:
            status = json.loads(remote_capture("tailscale", "status", "--json"))
            suffix = status["MagicDNSSuffix"].rstrip(".")
        except (ValueError, KeyError, TypeError, AttributeError):
            raise OperatorError("cannot discover tailnet origin; set GAK_AIAGENT_T3_URL") from None
        if not re.fullmatch(r"[a-zA-Z0-9.-]+", suffix) or "." not in suffix:
            raise OperatorError("invalid tailnet DNS suffix; set GAK_AIAGENT_T3_URL")
        value = f"https://{service}.{suffix}"
    return normalize_https_origin(value)


def check_web(base_url):
    try:
        with urllib.request.urlopen(base_url + "/", timeout=8) as response:
            if response.status != 200 or response.headers.get_content_type() != "text/html":
                raise OperatorError("T3 HTTPS origin is not serving its web page")
    except (OSError, urllib.error.URLError):
        raise OperatorError("T3 HTTPS origin is unreachable; check tailnet access and ingress") from None


def check_server():
    try:
        remote_capture(MANAGER, "exec", "aiagent-readiness", "--live")
    except OperatorError as error:
        if str(error).startswith("Gak command failed"):
            raise OperatorError("T3 server is unhealthy on Gak") from None
        raise


def read_pairing(raw, base_url):
    try:
        value = json.loads(raw)
        token = value["credential"]
        link = value["pairUrl"]
        expiry = value["expiresAt"]
        parsed = urlsplit(link)
        parts = parse_qs(parsed.fragment, strict_parsing=True)
        expires = dt.datetime.fromisoformat(expiry.replace("Z", "+00:00"))
        if (not isinstance(token, str) or not re.fullmatch(r"[A-Za-z0-9._~-]+", token)
                or not isinstance(link, str) or not isinstance(expiry, str)
                or link != base_url + "/pair#token=" + token
                or parsed.scheme != "https" or parsed.path != "/pair"
                or parsed.query or parts != {"token": [token]}
                or expires.tzinfo is None or expires <= dt.datetime.now(dt.timezone.utc)):
            raise ValueError
    except (ValueError, KeyError, TypeError, AttributeError):
        raise OperatorError("T3 returned a malformed pairing response; token withheld") from None
    return link, expiry


def pair(label):
    base_url = origin()
    check_web(base_url)
    check_server()
    raw = remote_capture(MANAGER, "exec", "t3", "auth", "pairing", "create",
                         "--base-dir", BASE_DIR, "--base-url", base_url,
                         "--ttl", "5m", "--label", label, "--json")
    link, expiry = read_pairing(raw, base_url)
    print(f"Pairing link (single use; expires {expiry}):\n{link}")
    if shutil.which("qrencode") is None:
        print("QR unavailable: install qrencode; use the link above.", file=sys.stderr)
        return
    qr = subprocess.run(["qrencode", "-t", "ANSIUTF8"], input=link,
                        text=True, capture_output=True)
    if qr.returncode:
        print("QR generation failed; use the link above.", file=sys.stderr)
    else:
        print(qr.stdout, end="")


def main(argv):
    if not argv or argv == ["help"] or argv == ["--help"]:
        usage()
        return 0 if argv else 2
    command = argv[0]
    if (command in ("status", "providers", "shell", "restart", "update", "provider-reseed")
            and (len(argv) == 1 or command in ("update", "provider-reseed")
                 and argv[1:] == ["--verbose"])):
        return subprocess.run(ssh_args(interactive=command == "shell")
                              + [remote_argv(MANAGER, *argv)]).returncode
    if command == "t3" and argv[1:] == ["open"]:
        base_url = origin()
        check_web(base_url)
        opener = shutil.which("xdg-open")
        if opener is None:
            raise OperatorError("xdg-open is required to open T3")
        result = subprocess.run([opener, base_url])
        if result.returncode:
            raise OperatorError("desktop opener failed")
        return 0
    if command == "t3" and len(argv) in (2, 3) and argv[1] == "pair":
        pair(argv[2] if len(argv) == 3 else socket.gethostname())
        return 0
    usage()
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except OperatorError as error:
        print(f"gak-aiagent: {error}", file=sys.stderr)
        sys.exit(1)
